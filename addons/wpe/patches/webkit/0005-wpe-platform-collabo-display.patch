+++ b/Source/WebKit/WPEPlatform/wpe/collabo/CMakeLists.txt
@@ -0,0 +1,38 @@
+# The collaboCore display backend. Its client library (collabo_gui.c, MIT) is collaboCore's own,
+# from COLLABO_GUI_CLIENT_DIR (tools/gui/client in the collaboCore tree).
+set(COLLABO_GUI_CLIENT_DIR "" CACHE PATH "collaboCore's GUI client library (tools/gui/client)")
+if (NOT EXISTS "${COLLABO_GUI_CLIENT_DIR}/collabo_gui.c")
+    message(FATAL_ERROR "ENABLE_WPE_PLATFORM_COLLABO needs COLLABO_GUI_CLIENT_DIR (collaboCore's tools/gui/client)")
+endif ()
+
+set(WPEPlatformCollabo_SOURCES
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/WPEDisplayCollabo.cpp
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/WPEToplevelCollabo.cpp
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/WPEViewCollabo.cpp
+    ${COLLABO_GUI_CLIENT_DIR}/collabo_gui.c
+)
+
+set(WPEPlatformCollabo_INSTALLED_HEADERS
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/wpe-collabo.h
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/WPEDisplayCollabo.h
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/WPEToplevelCollabo.h
+    ${WEBKIT_DIR}/WPEPlatform/wpe/collabo/WPEViewCollabo.h
+)
+
+set(WPEPlatformCollabo_PRIVATE_INCLUDE_DIRECTORIES
+    "${WPEPlatform_PRIVATE_INCLUDE_DIRECTORIES}"
+    "${WEBKIT_DIR}/WPEPlatform/wpe/collabo"
+    "${COLLABO_GUI_CLIENT_DIR}"
+)
+
+add_library(WPEPlatformCollabo OBJECT ${WPEPlatformCollabo_SOURCES})
+target_compile_options(WPEPlatformCollabo PRIVATE ${DEVELOPER_MODE_CXX_FLAGS})
+target_include_directories(WPEPlatformCollabo PRIVATE ${WPEPlatformCollabo_PRIVATE_INCLUDE_DIRECTORIES})
+target_include_directories(WPEPlatformCollabo SYSTEM PRIVATE ${WPEPlatform_SYSTEM_INCLUDE_DIRECTORIES})
+target_link_libraries(WPEPlatformCollabo ${WPEPlatform_LIBRARIES})
+add_dependencies(WPEPlatformCollabo WPEPlatformGeneratedEnumTypesHeader)
+
+install(FILES ${WPEPlatformCollabo_INSTALLED_HEADERS}
+        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/wpe-webkit-${WPE_API_VERSION}/wpe-platform/wpe/collabo"
+        COMPONENT "Development"
+)
