+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "WPEToplevelCollabo.h"
+
+#include "WPECollaboPrivate.h"
+#include <wtf/glib/WTFGType.h>
+
+/**
+ * WPEToplevelCollabo:
+ *
+ * The [class@WPEPlatform.Toplevel] of [class@DisplayCollabo]: a canvas of the display server.
+ * The server decides its size (within its limits; `gui resize` changes it); the toplevel's view
+ * is always as big as the canvas.
+ */
+struct _WPEToplevelCollaboPrivate {
+    uint32_t canvas;
+};
+WEBKIT_DEFINE_FINAL_TYPE(WPEToplevelCollabo, wpe_toplevel_collabo, WPE_TYPE_TOPLEVEL, WPEToplevel)
+
+uint32_t wpeToplevelCollaboGetCanvas(WPEToplevelCollabo* toplevel)
+{
+    return toplevel->priv->canvas;
+}
+
+WPEView* wpeToplevelCollaboGetView(WPEToplevelCollabo* toplevel)
+{
+    WPEView* view = nullptr;
+    wpe_toplevel_foreach_view(WPE_TOPLEVEL(toplevel), [](WPEToplevel*, WPEView* view, gpointer userData) -> gboolean {
+        *static_cast<WPEView**>(userData) = view;
+        return TRUE;
+    }, &view);
+    return view;
+}
+
+void wpeToplevelCollaboConfigure(WPEToplevelCollabo* toplevel, uint32_t width, uint32_t height)
+{
+    wpe_toplevel_resized(WPE_TOPLEVEL(toplevel), width, height);
+    wpe_toplevel_foreach_view(WPE_TOPLEVEL(toplevel), [](WPEToplevel* toplevel, WPEView* view, gpointer) -> gboolean {
+        int width, height;
+        wpe_toplevel_get_size(toplevel, &width, &height);
+        wpe_view_resized(view, width, height);
+        return FALSE;
+    }, nullptr);
+}
+
+static cg_display* connectionOf(WPEToplevel* toplevel)
+{
+    auto* display = wpe_toplevel_get_display(toplevel);
+    return display && WPE_IS_DISPLAY_COLLABO(display) ? wpeDisplayCollaboGetConnection(WPE_DISPLAY_COLLABO(display)) : nullptr;
+}
+
+static void wpeToplevelCollaboConstructed(GObject* object)
+{
+    G_OBJECT_CLASS(wpe_toplevel_collabo_parent_class)->constructed(object);
+
+    auto* toplevel = WPE_TOPLEVEL(object);
+    auto* priv = WPE_TOPLEVEL_COLLABO(object)->priv;
+    if (auto* gui = connectionOf(toplevel)) {
+        // the server's default size (or `gui run --size`); a later resize() asks for another
+        priv->canvas = cg_canvas_create(gui, 0, 0, g_get_application_name() ? g_get_application_name() : "Web");
+        if (priv->canvas) {
+            wpeDisplayCollaboAddToplevel(WPE_DISPLAY_COLLABO(wpe_toplevel_get_display(toplevel)), priv->canvas, WPE_TOPLEVEL_COLLABO(object));
+            uint32_t width = 0, height = 0;
+            cg_canvas_size(gui, priv->canvas, &width, &height);
+            if (width && height)
+                wpe_toplevel_resized(toplevel, width, height);
+        } else
+            g_warning("WPE collabo display: no canvas: %s", cg_error(gui));
+    }
+    wpe_toplevel_state_changed(toplevel, WPE_TOPLEVEL_STATE_ACTIVE);
+}
+
+static void wpeToplevelCollaboDispose(GObject* object)
+{
+    auto* toplevel = WPE_TOPLEVEL(object);
+    auto* priv = WPE_TOPLEVEL_COLLABO(object)->priv;
+    if (priv->canvas) {
+        if (auto* display = wpe_toplevel_get_display(toplevel))
+            wpeDisplayCollaboRemoveToplevel(WPE_DISPLAY_COLLABO(display), priv->canvas);
+        if (auto* gui = connectionOf(toplevel))
+            cg_canvas_destroy(gui, priv->canvas);
+        priv->canvas = 0;
+    }
+    G_OBJECT_CLASS(wpe_toplevel_collabo_parent_class)->dispose(object);
+}
+
+static void wpeToplevelCollaboSetTitle(WPEToplevel* toplevel, const char* title)
+{
+    auto* priv = WPE_TOPLEVEL_COLLABO(toplevel)->priv;
+    if (auto* gui = connectionOf(toplevel); gui && priv->canvas)
+        cg_canvas_set_title(gui, priv->canvas, title ? title : "");
+}
+
+static gboolean wpeToplevelCollaboResize(WPEToplevel* toplevel, int width, int height)
+{
+    // the server answers with the size it gives (CONFIGURE)
+    auto* priv = WPE_TOPLEVEL_COLLABO(toplevel)->priv;
+    auto* gui = connectionOf(toplevel);
+    if (!gui || !priv->canvas || width <= 0 || height <= 0)
+        return FALSE;
+    return cg_canvas_request_size(gui, priv->canvas, width, height) >= 0;
+}
+
+static gboolean wpeToplevelCollaboSetState(WPEToplevel* toplevel, WPEToplevelState flag, gboolean set)
+{
+    auto state = wpe_toplevel_get_state(toplevel);
+    state = static_cast<WPEToplevelState>(set ? (state | flag) : (state & ~flag));
+    wpe_toplevel_state_changed(toplevel, state);
+    return TRUE;
+}
+
+static void wpe_toplevel_collabo_class_init(WPEToplevelCollaboClass* toplevelCollaboClass)
+{
+    GObjectClass* objectClass = G_OBJECT_CLASS(toplevelCollaboClass);
+    objectClass->constructed = wpeToplevelCollaboConstructed;
+    objectClass->dispose = wpeToplevelCollaboDispose;
+
+    WPEToplevelClass* toplevelClass = WPE_TOPLEVEL_CLASS(toplevelCollaboClass);
+    toplevelClass->set_title = wpeToplevelCollaboSetTitle;
+    toplevelClass->resize = wpeToplevelCollaboResize;
+    toplevelClass->set_fullscreen = [](WPEToplevel* toplevel, gboolean fullscreen) -> gboolean {
+        return wpeToplevelCollaboSetState(toplevel, WPE_TOPLEVEL_STATE_FULLSCREEN, fullscreen);
+    };
+    toplevelClass->set_maximized = [](WPEToplevel* toplevel, gboolean maximized) -> gboolean {
+        return wpeToplevelCollaboSetState(toplevel, WPE_TOPLEVEL_STATE_MAXIMIZED, maximized);
+    };
+}
