+ * PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
+ * HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "WPEViewCollabo.h"
+
+#include "WPECollaboPrivate.h"
+#include <wtf/Vector.h>
+#include <wtf/glib/GRefPtr.h>
+#include <wtf/glib/WTFGType.h>
+
+/**
+ * WPEViewCollabo:
+ *
+ * The [class@WPEPlatform.View] of [class@DisplayCollabo]. Each buffer WebKit renders (shared
+ * memory, on the CPU) goes to the toplevel's canvas, its damaged rectangles only; the buffer is
+ * rendered when the server says the frame is on the canvas, which paces the web process to what
+ * the display takes.
+ */
+struct _WPEViewCollaboPrivate {
+    GRefPtr<WPEBuffer> pendingBuffer;
+    GRefPtr<WPEBuffer> committedBuffer;
+    int64_t pendingSerial;
+};
+WEBKIT_DEFINE_FINAL_TYPE(WPEViewCollabo, wpe_view_collabo, WPE_TYPE_VIEW, WPEView)
+
+static uint32_t canvasOf(WPEView* view)
+{
+    auto* toplevel = wpe_view_get_toplevel(view);
+    return toplevel && WPE_IS_TOPLEVEL_COLLABO(toplevel) ? wpeToplevelCollaboGetCanvas(WPE_TOPLEVEL_COLLABO(toplevel)) : 0;
+}
+
+static cg_display* connectionOf(WPEView* view)
+{
+    auto* display = wpe_view_get_display(view);
+    return display && WPE_IS_DISPLAY_COLLABO(display) ? wpeDisplayCollaboGetConnection(WPE_DISPLAY_COLLABO(display)) : nullptr;
+}
+
+void wpeViewCollaboFrameDone(WPEViewCollabo* viewCollabo, uint32_t serial)
+{
+    auto* view = WPE_VIEW(viewCollabo);
+    auto* priv = viewCollabo->priv;
+    if (!priv->pendingBuffer || serial != priv->pendingSerial)
+        return;
+    if (priv->committedBuffer && priv->committedBuffer != priv->pendingBuffer)
+        wpe_view_buffer_released(view, priv->committedBuffer.get());
+    priv->committedBuffer = WTF::move(priv->pendingBuffer);
+    wpe_view_buffer_rendered(view, priv->committedBuffer.get());
+}
+
+static void wpeViewCollaboToplevelChanged(WPEView* view, GParamSpec*, gpointer)
+{
+    auto* toplevel = wpe_view_get_toplevel(view);
+    if (!toplevel) {
+        wpe_view_unmap(view);
+        return;
+    }
+    int width, height;
+    wpe_toplevel_get_size(toplevel, &width, &height);
+    if (width && height)
+        wpe_view_resized(view, width, height);
+    wpe_view_map(view);
+}
+
+static void wpeViewCollaboConstructed(GObject* object)
+{
+    G_OBJECT_CLASS(wpe_view_collabo_parent_class)->constructed(object);
+
+    g_signal_connect(object, "notify::toplevel", G_CALLBACK(wpeViewCollaboToplevelChanged), nullptr);
+}
+
+static gboolean wpeViewCollaboRenderBuffer(WPEView* view, WPEBuffer* buffer, const WPERectangle* damageRects, guint damageCount, GError** error)
+{
+    auto* priv = WPE_VIEW_COLLABO(view)->priv;
+    auto* gui = connectionOf(view);
+    auto canvas = canvasOf(view);
+    if (!gui || !canvas) {
+        g_set_error_literal(error, WPE_VIEW_ERROR, WPE_VIEW_ERROR_RENDER_FAILED, "The view has no canvas");
+        return FALSE;
+    }
+    if (!WPE_IS_BUFFER_SHM(buffer)) {
+        g_set_error_literal(error, WPE_VIEW_ERROR, WPE_VIEW_ERROR_RENDER_FAILED, "Only shared memory buffers can be shown on the collaboCore display");
+        return FALSE;
+    }
+
+    auto* shm = WPE_BUFFER_SHM(buffer);
+    gsize size;
+    const auto* pixels = static_cast<const uint8_t*>(g_bytes_get_data(wpe_buffer_shm_get_data(shm), &size));
+    auto stride = wpe_buffer_shm_get_stride(shm);
+    int width = wpe_buffer_get_width(buffer), height = wpe_buffer_get_height(buffer);
+    if (width <= 0 || height <= 0 || static_cast<gsize>(stride) * height > size) {
+        g_set_error_literal(error, WPE_VIEW_ERROR, WPE_VIEW_ERROR_RENDER_FAILED, "Invalid buffer");
+        return FALSE;
+    }
+
+    // the damage within the buffer; none (or a first frame) sends all of it
+    Vector<cg_rect, 8> rects;
+    if (priv->committedBuffer || priv->pendingBuffer) {
+        for (guint i = 0; i < damageCount; ++i) {
+            int x0 = std::clamp(damageRects[i].x, 0, width), y0 = std::clamp(damageRects[i].y, 0, height);
+            int x1 = std::clamp(damageRects[i].x + damageRects[i].width, 0, width), y1 = std::clamp(damageRects[i].y + damageRects[i].height, 0, height);
+            if (x1 > x0 && y1 > y0)
+                rects.append({ static_cast<uint32_t>(x0), static_cast<uint32_t>(y0), static_cast<uint32_t>(x1 - x0), static_cast<uint32_t>(y1 - y0) });
+        }
+        if (damageCount && rects.isEmpty())
+            rects.append({ 0, 0, 1, 1 });
+    }
+    int64_t serial = cg_canvas_present(gui, canvas, pixels, stride, width, height, rects.isEmpty() ? nullptr : rects.span().data(), rects.size());
+    if (serial < 0) {
+        g_set_error(error, WPE_VIEW_ERROR, WPE_VIEW_ERROR_RENDER_FAILED, "The display server took no frame: %s", cg_error(gui));
+        return FALSE;
+    }
+
+    // a frame not yet on the canvas is replaced: release it, it will not be rendered
+    if (priv->pendingBuffer && priv->pendingBuffer != buffer && priv->pendingBuffer != priv->committedBuffer)
+        wpe_view_buffer_released(view, priv->pendingBuffer.get());
+    priv->pendingBuffer = buffer;
+    priv->pendingSerial = serial;
+    return TRUE;
+}
+
+static void wpeViewCollaboSetCursorFromName(WPEView* view, const char* name)
+{
+    auto* gui = connectionOf(view);
+    auto canvas = canvasOf(view);
+    if (gui && canvas)
+        cg_canvas_set_cursor(gui, canvas, name ? name : "default");
+}
+
+static void wpeViewCollaboDispose(GObject* object)
+{
+    auto* priv = WPE_VIEW_COLLABO(object)->priv;
+    priv->pendingBuffer = nullptr;
+    priv->committedBuffer = nullptr;
+    G_OBJECT_CLASS(wpe_view_collabo_parent_class)->dispose(object);
+}
+
+static void wpe_view_collabo_class_init(WPEViewCollaboClass* viewCollaboClass)
+{
+    GObjectClass* objectClass = G_OBJECT_CLASS(viewCollaboClass);
+    objectClass->constructed = wpeViewCollaboConstructed;
+    objectClass->dispose = wpeViewCollaboDispose;
+
+    WPEViewClass* viewClass = WPE_VIEW_CLASS(viewCollaboClass);
+    viewClass->render_buffer = wpeViewCollaboRenderBuffer;
+    viewClass->set_cursor_from_name = wpeViewCollaboSetCursorFromName;
+}
