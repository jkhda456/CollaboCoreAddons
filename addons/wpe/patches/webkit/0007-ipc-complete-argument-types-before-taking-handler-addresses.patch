+def complete_arguments_statement(receiver, message):
+    # The handler's address is taken before the templates that decode its arguments are
+    # instantiated, so a parameter type that is a class template specialization may not be complete
+    # yet; a function whose parameters are incomplete gets no signature of its own, and on
+    # WebAssembly the call through that address traps (wasm-ld: "function signature mismatch").
+    # Completing the argument types first gives the address the function's real type.
+    return '        static_assert(sizeof(Messages::%s::%s::Arguments));\n' % (receiver.name, message.name)
