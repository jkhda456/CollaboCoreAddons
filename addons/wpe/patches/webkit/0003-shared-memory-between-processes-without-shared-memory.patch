+#if defined(__wasm__)
+void SharedMemory::flushForSharing(size_t offset, size_t length)
+{
+    if (!m_fileDescriptor || offset >= m_size)
+        return;
+    length = std::min(length, m_size - offset);
+    // what the mapping holds, written to the file (pwrite, not msync: a read-only mapping is not
+    // written back by the mmap emulation, and the range need not be page-aligned)
+    auto bytes = span().subspan(offset, length);
+    while (!bytes.empty()) {
+        ssize_t written = pwrite(m_fileDescriptor.value(), bytes.data(), bytes.size(), offset);
+        if (written < 0 && errno == EINTR)
+            continue;
+        if (written <= 0)
+            return;
+        bytes = bytes.subspan(written);
+        offset += written;
+    }
+}
+
+void SharedMemory::reloadFromSharer(size_t offset, size_t length)
+{
+    if (!m_fileDescriptor || offset >= m_size)
+        return;
+    length = std::min(length, m_size - offset);
+    auto bytes = mutableSpan().subspan(offset, length);
+    while (!bytes.empty()) {
+        ssize_t read = pread(m_fileDescriptor.value(), bytes.data(), bytes.size(), offset);
+        if (read < 0 && errno == EINTR)
+            continue;
+        if (read <= 0)
+            return;
+        bytes = bytes.subspan(read);
+        offset += read;
+    }
+}
+#endif
+
