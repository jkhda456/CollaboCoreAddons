diff -ruN glibtest3/glib/glib-private.h glibtest4/glib/glib-private.h
--- a/glib/glib-private.h	2026-10-03 23:17:41.370651849 +0000
+++ b/glib/glib-private.h	2026-10-04 00:12:25.617895986 +0000
@@ -352,4 +352,98 @@
 #define _g_datalist_id_update_atomic(datalist, key_id, callback, user_data) \
   _g_datalist_id_update_atomic_full ((datalist), (key_id), FALSE, (callback), (user_data))
 
+/* Calls of callbacks as what they really are. Callbacks are often given as another type than the
+ * one they are called as (a function returning nothing as a GSourceFunc, a gboolean one as a
+ * GChildWatchFunc, one that leaves out its last parameters), which C tolerates on most machines;
+ * WebAssembly checks the type of every call through a pointer, so there the call goes through
+ * ffi_wasm_call (libffi for wasm32 as collaboCore's wpe add-on has it), which calls the function
+ * as its own type says: parameters it leaves out are not passed, a result it lacks is 0.
+ * The name says the call's type: v/b (no result, gboolean), then p/i per parameter. */
+#ifdef __wasm__
+/* weak: a program without that libffi (GLib alone) calls directly, as elsewhere */
+__attribute__ ((weak)) void ffi_wasm_call (void (*fn) (void), const char *sig, void *rvalue, void **avalue);
+#endif
+
+static inline gboolean
+g_callback_call_b_p (gpointer fn, gpointer a)
+{
+#ifdef __wasm__
+  if (ffi_wasm_call != NULL)
+    {
+      gboolean r = FALSE;
+      ffi_wasm_call ((void (*) (void)) fn, "i_i", &r, (void *[]) { &a });
+      return r;
+    }
+#endif
+  return ((gboolean (*) (gpointer)) fn) (a);
+}
+
+static inline void
+g_callback_call_v_p (gpointer fn, gpointer a)
+{
+#ifdef __wasm__
+  if (ffi_wasm_call != NULL)
+    {
+      ffi_wasm_call ((void (*) (void)) fn, "v_i", NULL, (void *[]) { &a });
+      return;
+    }
+#endif
+  ((void (*) (gpointer)) fn) (a);
+}
+
+static inline gboolean
+g_callback_call_b_pp (gpointer fn, gpointer a, gpointer b)
+{
+#ifdef __wasm__
+  if (ffi_wasm_call != NULL)
+    {
+      gboolean r = FALSE;
+      ffi_wasm_call ((void (*) (void)) fn, "i_ii", &r, (void *[]) { &a, &b });
+      return r;
+    }
+#endif
+  return ((gboolean (*) (gpointer, gpointer)) fn) (a, b);
+}
+
+static inline gboolean
+g_callback_call_b_pip (gpointer fn, gpointer a, gint b, gpointer c)
+{
+#ifdef __wasm__
+  if (ffi_wasm_call != NULL)
+    {
+      gboolean r = FALSE;
+      ffi_wasm_call ((void (*) (void)) fn, "i_iii", &r, (void *[]) { &a, &b, &c });
+      return r;
+    }
+#endif
+  return ((gboolean (*) (gpointer, gint, gpointer)) fn) (a, b, c);
+}
+
+static inline gboolean
+g_callback_call_b_iip (gpointer fn, gint a, gint b, gpointer c)
+{
+#ifdef __wasm__
+  if (ffi_wasm_call != NULL)
+    {
+      gboolean r = FALSE;
+      ffi_wasm_call ((void (*) (void)) fn, "i_iii", &r, (void *[]) { &a, &b, &c });
+      return r;
+    }
+#endif
+  return ((gboolean (*) (gint, gint, gpointer)) fn) (a, b, c);
+}
+
+static inline void
+g_callback_call_v_iip (gpointer fn, gint a, gint b, gpointer c)
+{
+#ifdef __wasm__
+  if (ffi_wasm_call != NULL)
+    {
+      ffi_wasm_call ((void (*) (void)) fn, "v_iii", NULL, (void *[]) { &a, &b, &c });
+      return;
+    }
+#endif
+  ((void (*) (gint, gint, gpointer)) fn) (a, b, c);
+}
+
 #endif /* __GLIB_PRIVATE_H__ */
