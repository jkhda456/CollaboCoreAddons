#!/usr/bin/env bash
# The C and C++ compiler of the wpe add-on's cross builds (meson, cmake, autotools all see it as
# an ordinary gcc-like compiler): userspace/bin/wasm-cc, with libc++ for C++ (wasm-wpe-c++),
# compat/ (what musl leaves out on wasm, libwasmcompat.a) and the guest's link flags for programs,
# without the flags Linux builds give that mean nothing on wasm32 or that wasm-ld refuses.
#
#   WPE_WASM_KEEP_NAMES=1   link with the function names kept (the engine's backtraces name them)
A="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "$A/../.." && pwd)"
LIBCXX="${WPE_LIBCXX:-$A/build/libcxx-install}"
SYS="$ROOT/userspace/sysroot"
cxx=0; [[ "${1:-}" == --wasm-wpe-c++ ]] && { cxx=1; shift; }

args=() link=1 partial=0 shared=0
for a in "$@"; do
  case "$a" in
    -fuse-ld=*|-Wl,--exclude-libs,*|-Wl,-z,noexecstack|-Wl,-z,relro|-Wl,-z,now|-Wl,-z,defs \
    |-Wl,--hash-style=*|-Wl,-soname,*|-Wl,-soname=*|-Wl,-rpath,*|-Wl,-rpath-link,*|-Wl,-O1 \
    |-fstack-protector*|-fPIC|-fpic|-mno-omit-leaf-frame-pointer|-mstack-alignment=*|-m32|-m64 \
    |-Wl,--allow-shlib-undefined|-Wl,--no-undefined|-Wl,-z,origin|-Wl,--enable-new-dtags|-Wl,--disable-new-dtags \
    |-Wl,--version-script=*|-Wl,--export-dynamic|-rdynamic|-fasynchronous-unwind-tables \
    |-fno-asynchronous-unwind-tables|-pthread|-Wl,-z,lazy|-Wl,--gc-sections|-Wl,-z,max-page-size=* \
    |-fPIE|-pie|-latomic|-lrt|-ldl|-lpthread|-Wl,--as-needed|-Wl,--no-as-needed|-Wl,-Bsymbolic* \
    |-fcf-protection*|-fstack-clash-protection|-march=*|-mtune=*|-Wl,--start-group|-Wl,--end-group \
    |-Wl,--no-undefined-version|-Wl,--undefined-version|-Wl,-z,pack-relative-relocs|-Wl,--build-id*)
      continue ;;
    -c|-S|-E|-M|-MM) link=0 ;;
    c++|c++-header|*.cpp|*.cc|*.cxx|*.hpp|*.C) cxx=1 ;;
    -r|-Wl,-r) partial=1 ;;
    -shared) shared=1 ;;
  esac
  args+=("$a")
done
for a in "${args[@]}"; do case "$a" in -print-*|--version|-v|-dumpmachine|-dumpversion) exec "$ROOT/userspace/bin/wasm-cc" "${args[@]}";; esac; done

pre=(-I"$A/compat/include") post=()
if [[ $cxx == 1 && $link == 0 ]]; then
  # wasm-cc's compile, with libc++'s headers ahead of the C library's (wasm-cc puts the sysroot's
  # first, and libc++'s <cstddef> must find its own <stddef.h>)
  exec "${WASM_CC_BIN:-clang++-19}" --target=wasm32 -matomics -mbulk-memory -mllvm -wasm-enable-sjlj \
    -D__linux__=1 -D__linux=1 -D__unix__=1 -D__unix=1 -D__gnu_linux__=1 \
    -Wno-unused-command-line-argument -Wno-override-module \
    "${pre[@]}" -nostdinc++ -isystem "$LIBCXX/include/c++/v1" -isystem "$LIBCXX/include" \
    -isystem "$SYS/include" "${args[@]}"
fi
if [[ $link == 1 && $partial == 0 ]]; then
  if [[ $shared == 1 ]]; then
    # No shared libraries for wasm32: everything is linked statically. A build that makes one
    # anyway (a test plugin) gets an empty file, which nothing here loads.
    out=a.out
    for ((i = 0; i < ${#args[@]}; i++)); do [[ "${args[i]}" == -o ]] && out="${args[i+1]}"; done
    echo "wasm-wpe-cc: no shared libraries on wasm32; $out left empty" >&2
    : > "$out"; exit 0
  fi
  post+=("$A/build/compat/libwasmcompat.a")
  # C programs too: a static C++ library (ICU, harfbuzz) linked into one needs them, and archives
  # only add what is used
  post+=("$LIBCXX/lib/libc++.a" "$LIBCXX/lib/libc++abi.a")
  post+=(-Wl,--wrap=pthread_getattr_np -Wl,--import-memory -Wl,--max-memory=4294967296 -Wl,--shared-memory
         -Wl,--export-table "-Wl,-z,stack-size=${WASM_STACK_SIZE:-8388608}")
fi
if [[ "${WPE_WASM_KEEP_NAMES:-0}" == 1 && $link == 1 && $partial == 0 ]]; then
  out=a.out
  for ((i = 0; i < ${#args[@]}; i++)); do [[ "${args[i]}" == -o ]] && out="${args[i+1]}"; done
  clang-19 --target=wasm32 -matomics -mbulk-memory -mllvm -wasm-enable-sjlj -Wno-unused-command-line-argument \
    -nostdlib -fuse-ld=/usr/bin/wasm-ld-19 -Wl,--table-base=3 -L"$SYS/lib" "$SYS/lib/crt1.o" \
    "${pre[@]}" "${args[@]}" "${post[@]}" -lc "$ROOT/userspace/out/rt/lib/wasm32-unknown-unknown/libclang_rt.builtins.a" || exit
  "$ROOT/.tools/binaryen/bin/wasm-opt" -all -g --translate-to-exnref "$out" -o "$out.exnref" && mv "$out.exnref" "$out"
  exit
fi
exec "$ROOT/userspace/bin/wasm-cc" "${pre[@]}" "${args[@]}" "${post[@]}"
