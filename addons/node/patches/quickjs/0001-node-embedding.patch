+int32_t JS_GetFunctionHostDefinedId(JSContext *ctx, JSValueConst func)
+{
+    JSObject *p;
+    if (JS_VALUE_GET_TAG(func) == JS_TAG_FUNCTION_BYTECODE)
+        return ((JSFunctionBytecode *)JS_VALUE_GET_PTR(func))->host_defined_id;
+    if (JS_VALUE_GET_TAG(func) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(func);
+    if (!js_class_has_bytecode(p->class_id))
+        return 0;
+    return p->u.func.function_bytecode->host_defined_id;
+}
