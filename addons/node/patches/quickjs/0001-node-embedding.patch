+/* node: where an exception was thrown or an error created: the first frame
+   with a source position of the error's captured stack, or of the backtrace
+   recorded when a non-error value was thrown.  Returns 0 when found. */
+int JS_NodeGetExceptionPosition(JSContext *ctx, JSValueConst exc,
+                                JSValue *pfilename, int *pline, int *pcol)
+{
+    JSRuntime *rt = ctx->rt;
+    JSValueConst holder = JS_UNDEFINED;
+    JSNodeLazyStack *ls;
+    int i;
+
+    *pfilename = JS_UNDEFINED;
+    *pline = -1;
+    *pcol = -1;
+    if (JS_VALUE_GET_TAG(exc) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_OBJ(exc)->class_id == JS_CLASS_ERROR &&
+        js_node_is_lazy_stack(rt, JS_VALUE_GET_OBJ(exc)->u.object_data))
+        holder = JS_VALUE_GET_OBJ(exc)->u.object_data;
+    else if (js_node_is_lazy_stack(rt, ctx->error_back_trace))
+        holder = ctx->error_back_trace;
+    ls = JS_GetOpaque(holder, rt->node_lazy_stack_class_id);
+    if (!ls)
+        return -1;
+    if (ls->has_first) {
+        *pfilename = js_dup(ls->first_filename);
+        *pline = ls->first_line;
+        *pcol = ls->first_col;
+        return 0;
+    }
+    for (i = 0; i < ls->count; i++) {
+        JSNodeLazyFrame *f = &ls->frames[i];
+        JSObject *p;
+        if (JS_VALUE_GET_TAG(f->func) != JS_TAG_OBJECT)
+            continue;
+        p = JS_VALUE_GET_OBJ(f->func);
+        if (js_class_has_bytecode(p->class_id) && f->pc >= 0) {
+            JSFunctionBytecode *b = p->u.func.function_bytecode;
+            int col = 0, line = -1;
+            if (b->pc2line_buf)
+                line = find_line_num(ctx, b, f->pc, &col);
+            if (line < 0 || !b->filename)
+                continue;
+            *pfilename = JS_AtomToString(ctx, b->filename);
+            *pline = line;
+            *pcol = col;
+            return 0;
+        }
+    }
+    return -1;
+}
+
+/* forget the backtrace of the last thrown value (after it was handled) */
+void JS_NodeClearBacktrace(JSContext *ctx)
+{
+    JS_FreeValue(ctx, ctx->error_back_trace);
+    ctx->error_back_trace = JS_UNDEFINED;
+}
