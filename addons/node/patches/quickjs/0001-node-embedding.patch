+static void js_keep_object(JSContext *ctx, JSValueConst v)
+{
+    JSRuntime *rt = ctx->rt;
+    if (rt->kept_count == rt->kept_size) {
+        int n = rt->kept_size ? rt->kept_size * 2 : 16;
+        JSValue *t = js_realloc_rt(rt, rt->kept_objects, n * sizeof(JSValue));
+        if (!t)
+            return;
+        rt->kept_objects = t;
+        rt->kept_size = n;
+    }
+    rt->kept_objects[rt->kept_count++] = js_dup(v);
+}
+
+void JS_ClearKeptObjects(JSRuntime *rt)
+{
+    /* freeing may finalize objects that keep more: take the list first */
+    while (rt->kept_count > 0) {
+        int n = rt->kept_count, i;
+        JSValue *list = rt->kept_objects;
+        rt->kept_objects = NULL;
+        rt->kept_count = rt->kept_size = 0;
+        for (i = 0; i < n; i++)
+            JS_FreeValueRT(rt, list[i]);
+        js_free_rt(rt, list);
+    }
+}
