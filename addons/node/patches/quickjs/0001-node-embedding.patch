+static JSValue js_node_lazy_stack_callsites(JSContext *ctx, JSNodeLazyStack *ls)
+{
+    JSValue arr = JS_NewArray(ctx);
+    JSCallSiteData csd;
+    uint32_t n = 0;
+    int i;
+    if (JS_IsException(arr))
+        return arr;
+    if (ls->has_first) {
+        memset(&csd, 0, sizeof(csd));
+        csd.func = JS_NULL;
+        csd.func_name = JS_NULL;
+        csd.filename = js_dup(ls->first_filename);
+        csd.line_num = ls->first_line;
+        csd.col_num = ls->first_col;
+        csd.is_toplevel = true;
+        if (JS_DefinePropertyValueUint32(ctx, arr, n++, js_new_callsite(ctx, &csd), JS_PROP_C_W_E) < 0)
+            goto fail;
+    }
+    for (i = 0; i < ls->count; i++) {
+        JSNodeLazyFrame *f = &ls->frames[i];
+        const char *name;
+        JSObject *p;
+        memset(&csd, 0, sizeof(csd));
+        csd.constructor = f->constructor;
+        csd.func = js_dup(f->func);
+        name = get_func_name(ctx, f->func);
+        if (!name || name[0] == '\0' || !strcmp(name, "<eval>"))
+            csd.func_name = JS_NULL;
+        else
+            csd.func_name = JS_NewString(ctx, name);
+        JS_FreeCString(ctx, name);
+        if (JS_IsException(csd.func_name))
+            csd.func_name = JS_NULL;
+        csd.is_toplevel = !f->constructor;
+        p = JS_VALUE_GET_TAG(f->func) == JS_TAG_OBJECT ? JS_VALUE_GET_OBJ(f->func) : NULL;
+        if (p && js_class_has_bytecode(p->class_id)) {
+            JSFunctionBytecode *b = p->u.func.function_bytecode;
+            int col = 0, line = -1;
+            if (f->pc >= 0 && b->pc2line_buf)
+                line = find_line_num(ctx, b, f->pc, &col);
+            csd.native = false;
+            csd.line_num = line;
+            csd.col_num = col;
+            csd.enclosing_line = b->line_num;
+            csd.enclosing_col = b->col_num;
+            csd.is_async = (b->func_kind & JS_FUNC_ASYNC) != 0 && f->pc >= 0 && false;
+            csd.filename = b->filename ? JS_AtomToString(ctx, b->filename) : JS_NULL;
+            if (JS_IsException(csd.filename)) {
+                csd.filename = JS_NULL;
+                JS_FreeValue(ctx, JS_GetException(ctx));
+            }
+        } else {
+            csd.native = true;
+            csd.line_num = -1;
+            csd.col_num = -1;
+            csd.enclosing_line = -1;
+            csd.enclosing_col = -1;
+            csd.filename = JS_NULL;
+        }
+        if (JS_DefinePropertyValueUint32(ctx, arr, n++, js_new_callsite(ctx, &csd), JS_PROP_C_W_E) < 0)
+            goto fail;
+    }
+    return arr;
+ fail:
+    JS_FreeValue(ctx, arr);
+    return JS_EXCEPTION;
+}
+
+static JSValue js_node_format_lazy_stack(JSContext *ctx, JSValueConst holder,
+                                         JSValueConst error)
+{
+    JSRuntime *rt = ctx->rt;
+    JSNodeLazyStack *ls = JS_GetOpaque(holder, rt->node_lazy_stack_class_id);
+    JSValue callsites, res;
+    if (!ls)
+        return JS_UNDEFINED;
+    if (!JS_IsUninitialized(ls->formatted))
+        return js_dup(ls->formatted);
+    if (ls->formatting || !rt->node_hooks.prepare_stack_trace)
+        return JS_UNDEFINED;
+    callsites = js_node_lazy_stack_callsites(ctx, ls);
+    if (JS_IsException(callsites))
+        return JS_EXCEPTION;
+    ls->formatting = true;
+    res = rt->node_hooks.prepare_stack_trace(ctx, error, callsites, rt->node_hooks_opaque);
+    ls->formatting = false;
+    JS_FreeValue(ctx, callsites);
+    if (JS_IsException(res))
+        return res;
+    if (JS_IsUninitialized(ls->formatted))
+        ls->formatted = js_dup(res);
+    else {
+        /* formatting assigned stack itself; keep that value */
+        JS_FreeValue(ctx, res);
+        res = js_dup(ls->formatted);
+    }
+    return res;
+}
