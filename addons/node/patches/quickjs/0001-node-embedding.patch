+/* every request of m and of the modules it links to must have its module
+   set; m is then marked resolved so the loader is never asked */
+static int js_node_mark_resolved(JSContext *ctx, JSModuleDef *m)
+{
+    int i;
+    if (m->resolved)
+        return 0;
+    for (i = 0; i < m->req_module_entries_count; i++) {
+        if (!m->req_module_entries[i].module) {
+            JSValue name = JS_AtomToString(ctx, m->req_module_entries[i].module_name);
+            const char *str = JS_ToCString(ctx, name);
+            JS_ThrowReferenceError(ctx, "request for '%s' is not yet linked", str ? str : "?");
+            JS_FreeCString(ctx, str);
+            JS_FreeValue(ctx, name);
+            return -1;
+        }
+    }
+    m->resolved = true;
+    for (i = 0; i < m->req_module_entries_count; i++) {
+        if (js_node_mark_resolved(ctx, m->req_module_entries[i].module) < 0) {
+            m->resolved = false;
+            return -1;
+        }
+    }
+    return 0;
+}
