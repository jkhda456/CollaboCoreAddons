+/* node: the bytes of an ArrayBuffer, SharedArrayBuffer, typed array or
+   DataView without copying; NULL (and no exception) for anything else */
+uint8_t *JS_NodeGetBufferBytes(JSContext *ctx, JSValueConst v, size_t *plen)
+{
+    static uint8_t empty[1];
+    JSObject *p;
+    JSArrayBuffer *abuf;
+    JSTypedArray *ta;
+    size_t len;
+
+    *plen = 0;
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(v);
+    switch (p->class_id) {
+    case JS_CLASS_ARRAY_BUFFER:
+    case JS_CLASS_SHARED_ARRAY_BUFFER:
+        abuf = p->u.array_buffer;
+        if (abuf->detached || !abuf->data)
+            return empty;
+        *plen = abuf->byte_length;
+        return abuf->data;
+    case JS_CLASS_DATAVIEW:
+    case JS_CLASS_UINT8C_ARRAY:
+    case JS_CLASS_INT8_ARRAY:
+    case JS_CLASS_UINT8_ARRAY:
+    case JS_CLASS_INT16_ARRAY:
+    case JS_CLASS_UINT16_ARRAY:
+    case JS_CLASS_INT32_ARRAY:
+    case JS_CLASS_UINT32_ARRAY:
+    case JS_CLASS_BIG_INT64_ARRAY:
+    case JS_CLASS_BIG_UINT64_ARRAY:
+    case JS_CLASS_FLOAT16_ARRAY:
+    case JS_CLASS_FLOAT32_ARRAY:
+    case JS_CLASS_FLOAT64_ARRAY:
+        ta = p->u.typed_array;
+        abuf = ta->buffer->u.array_buffer;
+        if (abuf->detached || !abuf->data)
+            return empty;
+        if (ta->offset > (uint32_t)abuf->byte_length)
+            return empty;
+        if (ta->track_rab)
+            len = abuf->byte_length - ta->offset;
+        else
+            len = ta->length;
+        if (ta->offset + len > (size_t)abuf->byte_length)
+            len = abuf->byte_length - ta->offset;
+        *plen = len;
+        return abuf->data + ta->offset;
+    default:
+        return NULL;
+    }
+}
+
+/* the ArrayBuffer under a typed array or DataView (dup), with its window */
+JSValue JS_NodeGetViewBuffer(JSContext *ctx, JSValueConst v, size_t *poffset, size_t *plen)
+{
+    JSObject *p;
+    JSTypedArray *ta;
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT)
+        return JS_UNDEFINED;
+    p = JS_VALUE_GET_OBJ(v);
+    if (!(p->class_id == JS_CLASS_DATAVIEW ||
+          (p->class_id >= JS_CLASS_UINT8C_ARRAY && p->class_id <= JS_CLASS_FLOAT64_ARRAY)))
+        return JS_UNDEFINED;
+    ta = p->u.typed_array;
+    *poffset = ta->offset;
+    JS_NodeGetBufferBytes(ctx, v, plen);
+    return js_dup(JS_MKPTR(JS_TAG_OBJECT, ta->buffer));
+}
+
+bool JS_NodeIsSharedArrayBuffer(JSValueConst v)
+{
+    return JS_VALUE_GET_TAG(v) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_OBJ(v)->class_id == JS_CLASS_SHARED_ARRAY_BUFFER;
+}
+
+bool JS_NodeIsArrayBufferView(JSValueConst v)
+{
+    JSObject *p;
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT)
+        return false;
+    p = JS_VALUE_GET_OBJ(v);
+    return p->class_id == JS_CLASS_DATAVIEW ||
+        (p->class_id >= JS_CLASS_UINT8C_ARRAY && p->class_id <= JS_CLASS_FLOAT64_ARRAY);
+}
