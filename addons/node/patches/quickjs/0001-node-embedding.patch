+/* Map/Set/WeakMap/WeakSet and their iterators: the entries as an array,
+   key/value pairs flattened when *is_key_value */
+JSValue JS_NodePreviewEntries(JSContext *ctx, JSValueConst obj, bool *is_key_value)
+{
+    JSObject *p;
+    JSMapState *s;
+    JSMapRecord *mr;
+    struct list_head *el;
+    JSValue arr;
+    uint32_t n = 0;
+    int kind = 2; /* 0 keys, 1 values, 2 entries */
+    bool is_set = false;
+
+    *is_key_value = false;
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return JS_UNDEFINED;
+    p = JS_VALUE_GET_OBJ(obj);
+    el = NULL;
+    switch (p->class_id) {
+    case JS_CLASS_MAP:
+    case JS_CLASS_WEAKMAP:
+        s = p->u.map_state;
+        kind = 2;
+        break;
+    case JS_CLASS_SET:
+    case JS_CLASS_WEAKSET:
+        s = p->u.map_state;
+        is_set = true;
+        kind = 0;
+        break;
+    case JS_CLASS_MAP_ITERATOR:
+    case JS_CLASS_SET_ITERATOR:
+        {
+            JSMapIteratorData *it = p->u.map_iterator_data;
+            if (!it || JS_IsUndefined(it->obj))
+                return JS_NewArray(ctx);
+            s = JS_VALUE_GET_OBJ(it->obj)->u.map_state;
+            is_set = p->class_id == JS_CLASS_SET_ITERATOR;
+            kind = it->kind == JS_ITERATOR_KIND_KEY ? 0 :
+                it->kind == JS_ITERATOR_KIND_VALUE ? 1 : 2;
+            if (is_set && kind == 1)
+                kind = 0;
+            if (it->cur_record)
+                el = it->cur_record->link.next;
+        }
+        break;
+    default:
+        return JS_UNDEFINED;
+    }
+    if (!s)
+        return JS_UNDEFINED;
+    if (!el)
+        el = s->records.next;
+    arr = JS_NewArray(ctx);
+    if (JS_IsException(arr))
+        return arr;
+    for (; el != &s->records; el = el->next) {
+        mr = list_entry(el, JSMapRecord, link);
+        if (mr->empty)
+            continue;
+        if (s->is_weak && JS_IsUndefined(mr->key))
+            continue;
+        if (kind == 0 || kind == 2) {
+            if (JS_DefinePropertyValueUint32(ctx, arr, n++, js_dup(mr->key), JS_PROP_C_W_E) < 0)
+                goto fail;
+        }
+        if (!is_set && (kind == 1 || kind == 2)) {
+            if (JS_DefinePropertyValueUint32(ctx, arr, n++, js_dup(mr->value), JS_PROP_C_W_E) < 0)
+                goto fail;
+        }
+        if (is_set && kind == 2) {
+            if (JS_DefinePropertyValueUint32(ctx, arr, n++, js_dup(mr->key), JS_PROP_C_W_E) < 0)
+                goto fail;
+        }
+    }
+    *is_key_value = (kind == 2);
+    return arr;
+ fail:
+    JS_FreeValue(ctx, arr);
+    return JS_EXCEPTION;
+}
