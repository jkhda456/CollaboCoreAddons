+JSValue JS_GetErrorStackValue(JSContext *ctx, JSValueConst error)
+{
+    /* the stack as `error.stack` would read it, without running getters
+       of a Proxy; returns undefined when there is none */
+    JSObject *p;
+    if (JS_VALUE_GET_TAG(error) != JS_TAG_OBJECT)
+        return JS_UNDEFINED;
+    p = JS_VALUE_GET_OBJ(error);
+    if (p->class_id == JS_CLASS_ERROR && js_node_is_lazy_stack(ctx->rt, p->u.object_data))
