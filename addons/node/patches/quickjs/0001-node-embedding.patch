+int JS_InstantiateModule(JSContext *ctx, JSModuleDef *m)
+{
+    if (js_node_mark_resolved(ctx, m) < 0)
+        return -1;
+    if (js_create_module_function(ctx, m) < 0)
+        return -1;
+    return js_link_module(ctx, m);
