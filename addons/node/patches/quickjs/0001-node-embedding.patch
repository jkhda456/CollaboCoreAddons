+static void js_node_build_lazy_backtrace(JSContext *ctx, JSValueConst error_obj,
+                                         JSValueConst filter_func,
+                                         const char *filename, int line_num,
+                                         int col_num, int backtrace_flags,
+                                         int stack_trace_limit)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf, *sf_start;
+    JSNodeLazyStack *ls;
+    JSValue holder;
+    int n = 0, limit;
+    bool has_filter_func = backtrace_flags & JS_BACKTRACE_FLAG_FILTER_FUNC;
+
+    if (!rt->node_lazy_stack_class_id) {
+        JSClassDef def = {
+            .class_name = "NodeLazyStack",
+            .finalizer = js_node_lazy_stack_finalizer,
+            .gc_mark = js_node_lazy_stack_mark,
+        };
+        JSClassID id = 0;
+        JS_NewClassID(rt, &id);
+        if (JS_NewClass(rt, id, &def) < 0)
+            return;
+        rt->node_lazy_stack_class_id = id;
+    }
+    limit = stack_trace_limit;
+    if (limit > 200)
+        limit = 200;
+    ls = js_mallocz(ctx, sizeof(*ls) + limit * sizeof(ls->frames[0]));
+    if (!ls)
+        return;
+    ls->formatted = JS_UNINITIALIZED;
+    ls->first_filename = JS_UNDEFINED;
+    if (limit > 0 && filename) {
+        ls->first_filename = JS_NewString(ctx, filename);
+        if (JS_IsException(ls->first_filename)) {
+            ls->first_filename = JS_UNDEFINED;
+            JS_FreeValue(ctx, JS_GetException(ctx));
+        }
+        ls->first_line = line_num;
+        ls->first_col = col_num;
+        ls->has_first = true;
+        limit--;
+    }
+    if (!(filename && (backtrace_flags & JS_BACKTRACE_FLAG_SINGLE_LEVEL))) {
+        sf_start = rt->current_stack_frame;
+        if (has_filter_func && JS_IsFunction(ctx, filter_func)) {
+            /* frames above the topmost call to filter_func, and that call,
+               are left out; none are kept if it is not on the stack */
+            for (sf = sf_start; sf != NULL; sf = sf->prev_frame) {
+                if (js_same_value(ctx, sf->cur_func, filter_func))
+                    break;
+            }
+            sf_start = sf;
+        }
+        for (sf = sf_start; sf != NULL && n < limit; sf = sf->prev_frame) {
+            JSNodeLazyFrame *f;
+            JSObject *p;
+            if (backtrace_flags & JS_BACKTRACE_FLAG_SKIP_FIRST_LEVEL) {
+                backtrace_flags &= ~JS_BACKTRACE_FLAG_SKIP_FIRST_LEVEL;
+                continue;
+            }
+            if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+                continue;
+            f = &ls->frames[n++];
+            f->func = js_dup(sf->cur_func);
+            f->constructor = sf->is_constructor;
+            f->pc = -1;
+            p = JS_VALUE_GET_OBJ(sf->cur_func);
+            if (js_class_has_bytecode(p->class_id)) {
+                JSFunctionBytecode *b = p->u.func.function_bytecode;
+                if (sf->cur_pc)
+                    f->pc = sf->cur_pc - b->byte_code_buf - 1;
+                if (b->backtrace_barrier)
+                    break;
+            }
+        }
+    }
+    ls->count = n;
+    holder = JS_NewObjectClass(ctx, rt->node_lazy_stack_class_id);
+    if (JS_IsException(holder)) {
+        JS_FreeValue(ctx, JS_GetException(ctx));
+        ls->count = 0;
+        for (n = 0; n < ls->count; n++)
+            JS_FreeValue(ctx, ls->frames[n].func);
+        JS_FreeValue(ctx, ls->first_filename);
+        js_free(ctx, ls);
+        return;
+    }
+    JS_SetOpaque(holder, ls);
+
+    if (JS_IsUndefined(ctx->error_back_trace))
+        ctx->error_back_trace = js_dup(holder);
+    if (has_filter_func || can_add_backtrace(error_obj)) {
+        JSValue getter, setter;
+        getter = JS_NewCFunctionData(ctx, js_node_lazy_stack_get, 0, 0, 1, vc(&holder));
+        setter = JS_NewCFunctionData(ctx, js_node_lazy_stack_set, 1, 0, 1, vc(&holder));
+        if (JS_DefineProperty(ctx, error_obj, JS_ATOM_stack, JS_UNDEFINED,
+                              getter, setter,
+                              JS_PROP_HAS_GET | JS_PROP_HAS_SET |
+                              JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE |
+                              JS_PROP_HAS_ENUMERABLE) < 0)
+            JS_FreeValue(ctx, JS_GetException(ctx));
+        JS_FreeValue(ctx, getter);
+        JS_FreeValue(ctx, setter);
+        JS_FreeValue(ctx, holder);
+    } else if (can_store_error_stack(error_obj)) {
+        JSObject *p = JS_VALUE_GET_OBJ(error_obj);
+        JS_FreeValue(ctx, p->u.object_data);
+        p->u.object_data = holder;
+        js_error_define_own_stack(ctx, error_obj);
+    } else {
+        JS_FreeValue(ctx, holder);
+    }
+}
+
