+/* ---- node: lazily formatted stacks (V8's Error.prepareStackTrace model) ---- */
+
+typedef struct JSNodeLazyFrame {
+    JSValue func;
+    int32_t pc;          /* -1 when unknown */
+    bool constructor;
+} JSNodeLazyFrame;
+
+typedef struct JSNodeLazyStack {
+    JSValue formatted;   /* JS_UNINITIALIZED until formatted or set */
+    JSValue first_filename; /* parse errors: the position as first frame */
+    int first_line, first_col;
+    bool has_first;
+    bool formatting;
+    int count;
+    JSNodeLazyFrame frames[];
+} JSNodeLazyStack;
+
+static void js_node_lazy_stack_finalizer(JSRuntime *rt, JSValueConst val)
+{
+    JSNodeLazyStack *ls = JS_GetOpaque(val, rt->node_lazy_stack_class_id);
+    int i;
+    if (!ls)
+        return;
+    JS_FreeValueRT(rt, ls->formatted);
+    JS_FreeValueRT(rt, ls->first_filename);
+    for (i = 0; i < ls->count; i++)
+        JS_FreeValueRT(rt, ls->frames[i].func);
+    js_free_rt(rt, ls);
+}
+
+static void js_node_lazy_stack_mark(JSRuntime *rt, JSValueConst val,
+                                    JS_MarkFunc *mark_func)
+{
+    JSNodeLazyStack *ls = JS_GetOpaque(val, rt->node_lazy_stack_class_id);
+    int i;
+    if (!ls)
+        return;
+    JS_MarkValue(rt, ls->formatted, mark_func);
+    for (i = 0; i < ls->count; i++)
+        JS_MarkValue(rt, ls->frames[i].func, mark_func);
+}
+
+static bool js_node_is_lazy_stack(JSRuntime *rt, JSValueConst val)
+{
