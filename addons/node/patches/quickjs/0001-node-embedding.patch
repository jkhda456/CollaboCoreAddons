+static JSValue js_node_lazy_stack_get(JSContext *ctx, JSValueConst this_val,
+                                      int argc, JSValueConst *argv, int magic,
+                                      JSValueConst *func_data)
+{
+    return js_node_format_lazy_stack(ctx, func_data[0], this_val);
+}
+
+static JSValue js_node_lazy_stack_set(JSContext *ctx, JSValueConst this_val,
+                                      int argc, JSValueConst *argv, int magic,
+                                      JSValueConst *func_data)
+{
+    JSNodeLazyStack *ls = JS_GetOpaque(func_data[0], ctx->rt->node_lazy_stack_class_id);
+    if (ls) {
+        JS_FreeValue(ctx, ls->formatted);
+        ls->formatted = js_dup(argc > 0 ? argv[0] : JS_UNDEFINED);
+    }
