+/* node: an own `stack` accessor on an error, as V8 has (Error.prototype's
+   getter and setter) */
+static void js_error_define_own_stack(JSContext *ctx, JSValueConst obj)
+{
+    JSObject *proto;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    JSValue getter, setter;
+
+    if (JS_VALUE_GET_TAG(ctx->class_proto[JS_CLASS_ERROR]) != JS_TAG_OBJECT)
+        return;
+    proto = JS_VALUE_GET_OBJ(ctx->class_proto[JS_CLASS_ERROR]);
+    prs = find_own_property(&pr, proto, JS_ATOM_stack);
+    if (!prs || (prs->flags & JS_PROP_TMASK) != JS_PROP_GETSET)
+        return;
+    getter = pr->u.getset.getter ? JS_MKPTR(JS_TAG_OBJECT, pr->u.getset.getter) : JS_UNDEFINED;
+    setter = pr->u.getset.setter ? JS_MKPTR(JS_TAG_OBJECT, pr->u.getset.setter) : JS_UNDEFINED;
+    if (JS_DefineProperty(ctx, obj, JS_ATOM_stack, JS_UNDEFINED, getter, setter,
+                          JS_PROP_HAS_GET | JS_PROP_HAS_SET |
+                          JS_PROP_HAS_CONFIGURABLE | JS_PROP_CONFIGURABLE |
+                          JS_PROP_HAS_ENUMERABLE) < 0)
+        JS_FreeValue(ctx, JS_GetException(ctx));
+}
