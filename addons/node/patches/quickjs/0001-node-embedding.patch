+/* ---- node: introspection for internalBinding('types') and ('util') ---- */
+
+uint32_t JS_NodeTypeFlags(JSValueConst v)
+{
+    JSObject *p;
+    uint32_t f = 0;
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(v);
+    switch (p->class_id) {
+    case JS_CLASS_ARGUMENTS:
+    case JS_CLASS_MAPPED_ARGUMENTS: f |= JS_NODE_TYPE_ARGUMENTS; break;
+    case JS_CLASS_ASYNC_FUNCTION: f |= JS_NODE_TYPE_ASYNC_FUNCTION; break;
+    case JS_CLASS_GENERATOR_FUNCTION: f |= JS_NODE_TYPE_GENERATOR_FUNCTION; break;
+    case JS_CLASS_ASYNC_GENERATOR_FUNCTION:
+        f |= JS_NODE_TYPE_ASYNC_FUNCTION | JS_NODE_TYPE_GENERATOR_FUNCTION; break;
+    case JS_CLASS_GENERATOR:
+    case JS_CLASS_ASYNC_GENERATOR: f |= JS_NODE_TYPE_GENERATOR_OBJECT; break;
+    case JS_CLASS_MAP_ITERATOR: f |= JS_NODE_TYPE_MAP_ITERATOR; break;
+    case JS_CLASS_SET_ITERATOR: f |= JS_NODE_TYPE_SET_ITERATOR; break;
+    case JS_CLASS_MODULE_NS: f |= JS_NODE_TYPE_MODULE_NAMESPACE; break;
+    case JS_CLASS_NUMBER: f |= JS_NODE_TYPE_NUMBER_OBJECT; break;
+    case JS_CLASS_STRING: f |= JS_NODE_TYPE_STRING_OBJECT; break;
+    case JS_CLASS_BOOLEAN: f |= JS_NODE_TYPE_BOOLEAN_OBJECT; break;
+    case JS_CLASS_SYMBOL: f |= JS_NODE_TYPE_SYMBOL_OBJECT; break;
+    case JS_CLASS_BIG_INT: f |= JS_NODE_TYPE_BIGINT_OBJECT; break;
+    case JS_CLASS_DATE: f |= JS_NODE_TYPE_DATE; break;
+    case JS_CLASS_REGEXP: f |= JS_NODE_TYPE_REGEXP; break;
+    case JS_CLASS_ERROR: f |= JS_NODE_TYPE_NATIVE_ERROR; break;
+    case JS_CLASS_MAP: f |= JS_NODE_TYPE_MAP; break;
+    case JS_CLASS_SET: f |= JS_NODE_TYPE_SET; break;
+    case JS_CLASS_WEAKMAP: f |= JS_NODE_TYPE_WEAKMAP; break;
+    case JS_CLASS_WEAKSET: f |= JS_NODE_TYPE_WEAKSET; break;
+    case JS_CLASS_PROMISE: f |= JS_NODE_TYPE_PROMISE; break;
+    case JS_CLASS_PROXY: f |= JS_NODE_TYPE_PROXY; break;
+    case JS_CLASS_ARRAY_BUFFER: f |= JS_NODE_TYPE_ARRAY_BUFFER; break;
+    case JS_CLASS_SHARED_ARRAY_BUFFER: f |= JS_NODE_TYPE_SHARED_ARRAY_BUFFER; break;
+    case JS_CLASS_DATAVIEW: f |= JS_NODE_TYPE_DATA_VIEW; break;
+    case JS_CLASS_WEAK_REF: f |= JS_NODE_TYPE_WEAK_REF; break;
+    case JS_CLASS_C_FUNCTION:
+    case JS_CLASS_C_FUNCTION_DATA:
+    case JS_CLASS_C_CLOSURE: f |= JS_NODE_TYPE_NATIVE_FUNCTION; break;
+    default:
+        break;
+    }
+    if (p->class_id >= JS_CLASS_UINT8C_ARRAY && p->class_id <= JS_CLASS_FLOAT64_ARRAY)
+        f |= JS_NODE_TYPE_TYPED_ARRAY;
+    return f;
+}
