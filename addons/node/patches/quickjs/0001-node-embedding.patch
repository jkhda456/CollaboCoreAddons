+/* a flat string's characters (8-bit Latin-1 or 16-bit UTF-16); *pval is
+   replaced by a flat string if it was a rope */
+const void *JS_NodeStringData(JSContext *ctx, JSValue *pval, uint32_t *plen, int *pwide)
+{
+    JSString *p;
+    if (JS_VALUE_GET_TAG(*pval) == JS_TAG_STRING_ROPE) {
+        JSValue flat = js_linearize_string_rope(ctx, *pval);
+        if (JS_IsException(flat))
+            return NULL;
+        JS_FreeValue(ctx, *pval);
+        *pval = flat;
+    }
+    if (JS_VALUE_GET_TAG(*pval) != JS_TAG_STRING)
+        return NULL;
+    p = JS_VALUE_GET_STRING(*pval);
+    *plen = p->len;
+    *pwide = p->is_wide_char;
+    return strv(p);
+}
+
+/* a new string from Latin-1 bytes (no UTF-8 decoding) */
+JSValue JS_NodeNewStringLatin1(JSContext *ctx, const uint8_t *buf, size_t len)
+{
+    JSString *str;
+    if (len > JS_STRING_LEN_MAX)
+        return JS_ThrowRangeError(ctx, "Invalid string length");
+    str = js_alloc_string(ctx, len, 0);
+    if (!str)
+        return JS_EXCEPTION;
+    memcpy(str8(str), buf, len);
+    str8(str)[len] = '\0';
+    return JS_MKPTR(JS_TAG_STRING, str);
+}
+
+/* a new string from UTF-16 code units, narrowed when they all fit in 8 bits */
+JSValue JS_NodeNewStringUTF16(JSContext *ctx, const uint16_t *buf, size_t len)
+{
+    JSString *str;
+    size_t i;
+    uint16_t c = 0;
+    if (len > JS_STRING_LEN_MAX)
+        return JS_ThrowRangeError(ctx, "Invalid string length");
+    for (i = 0; i < len; i++)
+        c |= buf[i];
+    if (c < 0x100) {
+        str = js_alloc_string(ctx, len, 0);
+        if (!str)
+            return JS_EXCEPTION;
+        for (i = 0; i < len; i++)
+            str8(str)[i] = buf[i];
+        str8(str)[len] = '\0';
+    } else {
+        str = js_alloc_string(ctx, len, 1);
+        if (!str)
+            return JS_EXCEPTION;
+        memcpy(str16(str), buf, len * 2);
+    }
+    return JS_MKPTR(JS_TAG_STRING, str);
+}
+
+/* a new string with uninitialized contents, to be filled through the
+   returned pointer (8-bit when !wide) */
+JSValue JS_NodeNewStringRaw(JSContext *ctx, size_t len, int wide, void **pdata)
+{
+    JSString *str;
+    if (len > JS_STRING_LEN_MAX)
+        return JS_ThrowRangeError(ctx, "Invalid string length");
+    str = js_alloc_string(ctx, len, wide);
+    if (!str)
+        return JS_EXCEPTION;
+    if (!wide)
+        str8(str)[len] = '\0';
+    *pdata = strv(str);
+    return JS_MKPTR(JS_TAG_STRING, str);
+}
