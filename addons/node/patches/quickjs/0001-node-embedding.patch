+/* the stack frames of the running code: function names and positions, for
+   util.getCallSites() and the like */
+int JS_NodeCurrentFrameCount(JSContext *ctx)
+{
+    JSStackFrame *sf;
+    int n = 0;
+    for (sf = ctx->rt->current_stack_frame; sf != NULL; sf = sf->prev_frame)
+        n++;
+    return n;
+}
