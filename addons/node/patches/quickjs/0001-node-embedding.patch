+/* node: CallSite objects for the running code, skipping `skip` frames */
+JSValue JS_NodeCaptureCallSites(JSContext *ctx, int skip, int limit)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf;
+    JSNodeLazyStack *ls;
+    JSValue arr;
+    int n = 0, i;
+    if (limit < 0)
+        limit = 0;
+    if (limit > 1000)
+        limit = 1000;
+    ls = js_mallocz(ctx, sizeof(*ls) + limit * sizeof(ls->frames[0]));
+    if (!ls)
+        return JS_EXCEPTION;
+    ls->formatted = JS_UNINITIALIZED;
+    ls->first_filename = JS_UNDEFINED;
+    for (sf = rt->current_stack_frame; sf != NULL && n < limit; sf = sf->prev_frame) {
+        JSNodeLazyFrame *f;
+        JSObject *p;
+        if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+            continue;
+        if (skip > 0) {
+            skip--;
+            continue;
+        }
+        f = &ls->frames[n++];
+        f->func = js_dup(sf->cur_func);
+        f->constructor = sf->is_constructor;
+        f->pc = -1;
+        p = JS_VALUE_GET_OBJ(sf->cur_func);
+        if (js_class_has_bytecode(p->class_id) && sf->cur_pc)
+            f->pc = sf->cur_pc - p->u.func.function_bytecode->byte_code_buf - 1;
+    }
+    ls->count = n;
+    arr = js_node_lazy_stack_callsites(ctx, ls);
+    for (i = 0; i < n; i++)
+        JS_FreeValue(ctx, ls->frames[i].func);
+    js_free(ctx, ls);
+    return arr;
+}
