+/* node: true when input parses as a module (nothing is kept); the parse
+   error stays pending when it does not */
+int JS_NodeCheckModuleSyntax(JSContext *ctx, const char *input, size_t input_len,
+                             const char *filename)
+{
+    JSValue v;
+    JSModuleDef *m;
+    v = __JS_EvalInternal(ctx, JS_UNDEFINED, input, input_len, filename, 1,
+                          JS_EVAL_TYPE_MODULE | JS_EVAL_FLAG_COMPILE_ONLY, -1);
+    if (JS_IsException(v))
+        return 0;
+    m = JS_VALUE_GET_PTR(v);
+    JS_FreeValue(ctx, v);
+    js_free_module_def(ctx, m);
+    return 1;
+}
