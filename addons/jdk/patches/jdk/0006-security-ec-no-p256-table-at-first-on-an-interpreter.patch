+    // An interpreter (HotSpot's Zero, as in the WebAssembly port for collaboCore) takes about as
+    // long to build the secp256r1 generator's table as for 64 multiplications without it (some
+    // 2 seconds in the WebAssembly guest, 20 without Zero's multiplication in C: long enough for
+    // a TLS server to give up on the handshake), so it multiplies without the table (and without
+    // making it) for its first 64 multiplications on secp256r1.
+    private static final boolean INTERPRETER_ONLY =
+            jdk.internal.misc.VM.getSavedProperty("java.vm.info") != null
+            && jdk.internal.misc.VM.getSavedProperty("java.vm.info").contains("interpreted mode");
+    private static final java.util.concurrent.atomic.AtomicInteger generatorMultiplications =
+            new java.util.concurrent.atomic.AtomicInteger();
+
+    private static boolean precomputedTableWorthIt() {
+        return !INTERPRETER_ONLY || generatorMultiplications.incrementAndGet() > 64;
+    }
