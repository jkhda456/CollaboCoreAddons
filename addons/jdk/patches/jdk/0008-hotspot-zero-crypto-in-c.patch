+// ── P-256 (sun.security.util.math.intpoly) ───────────────────────────────────────────────────
+
+// MontgomeryIntegerPolynomialP256.mult(long[] a, long[] b, long[] r): the Java code's Montgomery
+// multiplication modulo p in five 52-bit limbs, its five unrolled rows as a loop.
+bool p256_mult(const Args& args) {
+  typeArrayOop at = args.a(1), bt = args.a(2), rt = args.a(3);
+  if (at == nullptr || at->length() < 5 || bt == nullptr || bt->length() < 5 || rt == nullptr || rt->length() < 5) {
+    return false;
+  }
+  static const julong M[5] = { 0x000fffffffffffffULL, 0x00000fffffffffffULL, 0, 0x0000001000000000ULL,
+                               0x0000ffffffff0000ULL };
+  const julong MASK = (1ULL << 52) - 1;
+  const julong* a = (const julong*) at->base(T_LONG);
+  const julong* b = (const julong*) bt->base(T_LONG);
+  julong c[10] = { 0 };
+  for (int i = 0; i < 5; i++) {
+    julong d[5], dd[5];
+    for (int j = 0; j < 5; j++) {
+      julong lo = a[i] * b[j];
+      dd[j] = umulh(a[i], b[j]) << 12 | (lo >> 52);
+      d[j] = lo & MASK;
+    }
+    d[0] += c[i];
+    julong n = d[0] & MASK;
+    for (int j = 0; j < 5; j++) {
+      julong lo = n * M[j];
+      dd[j] += umulh(n, M[j]) << 12 | (lo >> 52);
+      d[j] += lo & MASK;
+    }
+    if (i < 4) {
+      c[i + 1] += d[1] + dd[0] + (d[0] >> 52);
+      c[i + 2] += d[2] + dd[1];
+      c[i + 3] += d[3] + dd[2];
+      c[i + 4] += d[4] + dd[3];
+      c[i + 5] = dd[4];
+    } else {
+      c[5] += d[1] + dd[0] + (d[0] >> 52);
+      c[6] += d[2] + dd[1] + (c[5] >> 52);
+      c[7] += d[3] + dd[2] + (c[6] >> 52);
+      c[8] += d[4] + dd[3] + (c[7] >> 52);
+      c[9] = dd[4] + (c[8] >> 52);
+    }
+  }
+  for (int k = 5; k < 9; k++) {
+    c[k] &= MASK;
+  }
+  // Subtract p once, with signed carries; keep {c5..c9} if that went below zero
+  c[0] = c[5] - M[0];
+  for (int k = 1; k < 5; k++) {
+    c[k] = c[k + 5] - M[k] + (julong) ((jlong) c[k - 1] >> 52);
+    c[k - 1] &= MASK;
+  }
+  julong mask = (julong) ((jlong) c[4] >> 63);
+  julong* r = (julong*) rt->base(T_LONG);
+  for (int k = 0; k < 5; k++) {
+    r[k] = (c[k + 5] & mask) | (c[k] & ~mask);
+  }
+  return true;
+}
+
+// IntegerPolynomial.conditionalAssign(int set, long[] a, long[] b): a = b if set is 1.
+bool intpoly_assign(const Args& args) {
+  typeArrayOop at = args.a(1), bt = args.a(2);
+  if (at == nullptr || bt == nullptr || bt->length() < at->length()) {
+    return false;
+  }
+  julong mask = (julong) (jlong) (jint) (0u - (juint) args.i(0));
+  julong* a = (julong*) at->base(T_LONG);
+  const julong* b = (const julong*) bt->base(T_LONG);
+  for (int i = 0; i < at->length(); i++) {
+    a[i] ^= mask & (a[i] ^ b[i]);
+  }
+  return true;
+}
