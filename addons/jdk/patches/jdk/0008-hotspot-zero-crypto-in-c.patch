+// ── BigInteger (java.math) ───────────────────────────────────────────────────────────────────
+// Magnitudes are big-endian int[]s: element 0 is the most significant word.
+
+// implMultiplyToLen: z[0 .. xlen+ylen) = x[0 .. xlen) * y[0 .. ylen).
+void multiply_to_len(const juint* x, int xlen, const juint* y, int ylen, juint* z) {
+  julong carry = 0;
+  for (int j = ylen - 1, k = ylen + xlen - 1; j >= 0; j--, k--) {
+    julong product = (julong) y[j] * x[xlen - 1] + carry;
+    z[k] = (juint) product;
+    carry = product >> 32;
+  }
+  z[xlen - 1] = (juint) carry;
+  for (int i = xlen - 2; i >= 0; i--) {
+    carry = 0;
+    for (int j = ylen - 1, k = ylen + i; j >= 0; j--, k--) {
+      julong product = (julong) y[j] * x[i] + z[k] + carry;
+      z[k] = (juint) product;
+      carry = product >> 32;
+    }
+    z[i] = (juint) carry;
+  }
+}
+
+// implMulAdd: out[out_len-offset-len .. out_len-offset) += in[0 .. len) * k; returns the carry.
+juint mul_add(juint* out, int out_len, const juint* in, int offset, int len, juint k) {
+  julong carry = 0;
+  offset = out_len - offset - 1;
+  for (int j = len - 1; j >= 0; j--) {
+    julong product = (julong) in[j] * k + out[offset] + carry;
+    out[offset--] = (juint) product;
+    carry = product >> 32;
+  }
+  return (juint) carry;
+}
+
+// montReduce(n, mod, mlen, inv) with addOne, subN and intArrayCmpToLen, as BigInteger.java has them.
+void mont_reduce(juint* n, int n_len, const juint* mod, int mlen, juint inv) {
+  jint c = 0;
+  int len = mlen, offset = 0;
+  do {
+    juint carry = mul_add(n, n_len, mod, offset, mlen, inv * n[n_len - 1 - offset]);
+    // addOne(n, offset, mlen, carry)
+    int o = n_len - 1 - mlen - offset;
+    julong t = (julong) n[o] + carry;
+    n[o] = (juint) t;
+    if ((t >> 32) != 0) {
+      int m = mlen, add = 1;
+      while (--m >= 0) {
+        if (--o < 0) {
+          break;
+        }
+        if (++n[o] != 0) {
+          add = 0;
+          break;
+        }
+      }
+      c += add;
+    }
+    offset++;
+  } while (--len > 0);
+  for (;;) {
+    // while (c > 0) c += subN(n, mod, mlen); then while (n >= mod) subN(n, mod, mlen)
+    bool ge = true;
+    if (c <= 0) {
+      for (int i = 0; i < mlen; i++) {
+        if (n[i] != mod[i]) {
+          ge = n[i] > mod[i];
+          break;
+        }
+      }
+      if (!ge) {
+        break;
+      }
+    }
+    jlong sum = 0;
+    for (int i = mlen - 1; i >= 0; i--) {
+      sum = (jlong) n[i] - (jlong) mod[i] + (sum >> 32);
+      n[i] = (juint) sum;
+    }
+    if (c > 0) {
+      c += (jint) (sum >> 32);
+    }
+  }
+}
+
+// BigInteger.implMultiplyToLen(int[] x, int xlen, int[] y, int ylen, int[] z) returns z
+bool bigint_multiply(const Args& args, Result* result) {
+  typeArrayOop x = args.a(0), y = args.a(2), z = args.a(4);
+  jint xlen = args.i(1), ylen = args.i(3);
+  if (x == nullptr || y == nullptr || z == nullptr || xlen < 1 || ylen < 1 || xlen > x->length() ||
+      ylen > y->length() || (jlong) xlen + ylen > z->length() || x == z || y == z) {
+    return false;
+  }
+  multiply_to_len((const juint*) x->base(T_INT), xlen, (const juint*) y->base(T_INT), ylen, (juint*) z->base(T_INT));
+  return result->set_object(z);
+}
+
+// BigInteger.implSquareToLen(int[] x, int len, int[] z, int zlen) returns z
+bool bigint_square(const Args& args, Result* result) {
+  typeArrayOop x = args.a(0), z = args.a(2);
+  jint len = args.i(1), zlen = args.i(3);
+  if (x == nullptr || z == nullptr || len < 1 || len > x->length() || zlen != 2 * len ||
+      zlen > z->length() || x == z) {
+    return false;
+  }
+  const juint* xs = (const juint*) x->base(T_INT);
+  multiply_to_len(xs, len, xs, len, (juint*) z->base(T_INT));
+  return result->set_object(z);
+}
+
+// BigInteger.implMulAdd(int[] out, int[] in, int offset, int len, int k)
+bool bigint_mul_add(const Args& args, Result* result) {
+  typeArrayOop out = args.a(0), in = args.a(1);
+  jint offset = args.i(2), len = args.i(3);
+  if (out == nullptr || in == nullptr || len < 0 || len > in->length() || offset < 0 ||
+      (jlong) offset + len > out->length() || out == in) {
+    return false;
+  }
+  return result->set_int((jint) mul_add((juint*) out->base(T_INT), out->length(), (const juint*) in->base(T_INT),
+                                        offset, len, (juint) args.i(4)));
+}
+
+// BigInteger.implMontgomeryMultiply(int[] a, int[] b, int[] n, int len, long inv, int[] product)
+// and implMontgomerySquare(int[] a, int[] n, int len, long inv, int[] product): product = a * b,
+// reduced; when product is too short for that, Java allocates one.
+bool bigint_montgomery(const Args& args, bool square, Result* result) {
+  int at = square ? 1 : 0;  // the arguments after b
+  typeArrayOop a = args.a(0), b = square ? a : args.a(1), n = args.a(2 - at);
+  jint len = args.i(3 - at);
+  jlong inv = args.l(4 - at);
+  typeArrayOop product = args.a(6 - at);
+  if (a == nullptr || b == nullptr || n == nullptr || product == nullptr || len < 1 ||
+      len > a->length() || len > b->length() || len > n->length() || 2 * len > product->length() ||
+      product == a || product == b || product == n) {
+    return false;
+  }
+  juint* p = (juint*) product->base(T_INT);
+  multiply_to_len((const juint*) a->base(T_INT), len, (const juint*) b->base(T_INT), len, p);
+  mont_reduce(p, product->length(), (const juint*) n->base(T_INT), len, (juint) inv);
+  return result->set_object(product);
+}
+
+} // namespace
+
+int ZeroInterpreter::intrinsic_entry(Method* method, intptr_t UNUSED, TRAPS) {
+  JavaThread* thread = THREAD;
+  // Safepoints, and a debugger that wants to see every bytecode, go the slow way
+  if (SafepointMechanism::should_process(thread) || thread->is_interp_only_mode()) {
+    return normal_entry(method, 0, THREAD);
+  }
+
+  ZeroStack* stack = thread->zero_stack();
+  intptr_t* sp = stack->sp();
+  int size = method->size_of_parameters();
+  Args args(sp, size);
+  Result result;
+  bool done = false;
+  switch (method->intrinsic_id()) {
+    case vmIntrinsics::_aescrypt_encryptBlock:       done = aes_block(args, false); break;
+    case vmIntrinsics::_aescrypt_decryptBlock:       done = aes_block(args, true); break;
+    case vmIntrinsics::_counterMode_AESCrypt:        done = ctr_crypt(method->method_holder(), args, &result); break;
+    case vmIntrinsics::_ghash_processBlocks:         done = ghash_blocks(args); break;
+    case vmIntrinsics::_md5_implCompress:            // fall thru
+    case vmIntrinsics::_sha_implCompress:            // fall thru
+    case vmIntrinsics::_sha2_implCompress:           // fall thru
+    case vmIntrinsics::_sha5_implCompress:           done = digest_block(args); break;
+    case vmIntrinsics::_digestBase_implCompressMB:   done = digest_blocks(args, &result); break;
+    case vmIntrinsics::_intpoly_montgomeryMult_P256: done = p256_mult(args); break;
+    case vmIntrinsics::_intpoly_assign:              done = intpoly_assign(args); break;
+    case vmIntrinsics::_multiplyHigh:                done = result.set_long(smulh(args.l(0), args.l(2))); break;
+    case vmIntrinsics::_unsignedMultiplyHigh:        done = result.set_long((jlong) umulh(args.l(0), args.l(2))); break;
+    case vmIntrinsics::_multiplyToLen:               done = bigint_multiply(args, &result); break;
+    case vmIntrinsics::_squareToLen:                 done = bigint_square(args, &result); break;
+    case vmIntrinsics::_mulAdd:                      done = bigint_mul_add(args, &result); break;
+    case vmIntrinsics::_montgomeryMultiply:          done = bigint_montgomery(args, false, &result); break;
+    case vmIntrinsics::_montgomerySquare:            done = bigint_montgomery(args, true, &result); break;
+    default:                                         break;
+  }
+  if (!done) {
+    return normal_entry(method, 0, THREAD);
+  }
+
+  // Pop the arguments, push the result
+  intptr_t* top = sp + size - type2size[result.type];
+  stack->set_sp(top);
+  switch (result.type) {
+    case T_INT:    *(jint*) top = result.i; break;
+    case T_LONG:   *(jlong*) top = result.l; break;
+    case T_OBJECT: *(oop*) top = result.o; break;
+    default:       break;
+  }
+
+  // No deoptimized frames on the stack
+  return 0;
+}
