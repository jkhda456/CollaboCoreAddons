+// Crypto and big-number methods that the compilers replace with intrinsics, run in C by Zero: AES
+// blocks, AES in counter mode, GHASH, the compression functions of MD5, SHA-1, SHA-2 and SHA-512,
+// P-256 Montgomery multiplication, Math.multiplyHigh and BigInteger's multiply, square, mulAdd and
+// Montgomery steps. Interpreted, bulk AES and SHA-2 move about 100-200 KB/s and a P-256 signature
+// check takes a second, which makes TLS too slow to download anything. Each entry reads the
+// method's arguments off the Zero stack and the fields it needs off the objects, does what the
+// Java code does, and returns; anything unexpected (a null, an index out of range, a cipher other
+// than AES, an array that would have to be allocated) goes to the bytecodes instead, which also
+// throw the right exception.
+
+#include "classfile/classLoaderData.inline.hpp"
+#include "classfile/vmIntrinsics.hpp"
+#include "interpreter/zero/zeroInterpreter.hpp"
+#include "oops/fieldStreams.inline.hpp"
+#include "oops/instanceKlass.hpp"
+#include "oops/method.hpp"
+#include "oops/oop.inline.hpp"
+#include "oops/typeArrayOop.inline.hpp"
+#include "runtime/atomic.hpp"
+#include "runtime/javaThread.hpp"
+#include "runtime/safepointMechanism.inline.hpp"
+#include "utilities/globalDefinitions.hpp"
+
+#include "stack_zero.inline.hpp"
+
+namespace {
+
+// ── the Java objects ──────────────────────────────────────────────────────────────────────────
+
+// A field's offset in k or its superclasses, -1 if there is none.
+int field_offset(Klass* k, const char* name, const char* sig) {
+  for (; k != nullptr; k = k->super()) {
+    if (!k->is_instance_klass()) {
+      continue;
+    }
+    for (JavaFieldStream fs(InstanceKlass::cast(k)); !fs.done(); fs.next()) {
+      if (!fs.access_flags().is_static() && fs.name()->equals(name) && fs.signature()->equals(sig)) {
+        return fs.offset();
+      }
+    }
+  }
+  return -1;
+}
+
+// The class of the boot loader named name that k is or extends, null if none.
+Klass* boot_class(Klass* k, const char* name) {
+  for (; k != nullptr; k = k->super()) {
+    if (k->name()->equals(name) && k->class_loader_data()->is_boot_class_loader_data()) {
+      return k;
+    }
+  }
+  return nullptr;
+}
+
+// Offsets of a class's fields, looked up once. Several threads may look them up at the same time;
+// they find the same numbers, and klass is published last.
+template <int N>
+struct Fields {
+  Klass* volatile klass;
+  int off[N];
+
+  bool lookup(Klass* k, const char* const (&names)[N][2]) {
+    if (Atomic::load_acquire(&klass) == k) {
+      return true;
+    }
+    for (int i = 0; i < N; i++) {
+      off[i] = field_offset(k, names[i][0], names[i][1]);
+      if (off[i] < 0) {
+        return false;
+      }
+    }
+    Atomic::release_store(&klass, k);
+    return true;
+  }
+};
+
+// A byte[], int[] or long[] field, null if the field is null or shorter than min.
+template <typename T>
+T* array_field(oop o, int offset, BasicType type, int min) {
+  typeArrayOop a = (typeArrayOop) o->obj_field(offset);
+  if (a == nullptr || a->length() < min) {
+    return nullptr;
+  }
+  return (T*) a->base(type);
+}
+
+// Whether [ofs, ofs + len) lies in the array a (of any length when len is 0).
+bool in_bounds(typeArrayOop a, jint ofs, jlong len) {
+  return a != nullptr && ofs >= 0 && len >= 0 && (jlong) ofs + len <= a->length();
+}
+
+// A method's arguments on the Zero stack, by local index (the receiver, if any, is 0): the first
+// is deepest, and a long's two slots hold it at the lower address.
+class Args {
+  intptr_t* _sp;
+  int _size;
+
+ public:
+  Args(intptr_t* sp, int size) : _sp(sp), _size(size) {}
+  jint i(int n) const { return *(jint*) &_sp[_size - 1 - n]; }
+  jlong l(int n) const { return *(jlong*) &_sp[_size - 2 - n]; }
+  oop o(int n) const { return cast_to_oop(_sp[_size - 1 - n]); }
+  typeArrayOop a(int n) const { return (typeArrayOop) o(n); }
+};
+
+// What a method returns.
+struct Result {
+  BasicType type = T_VOID;
+  jint i = 0;
+  jlong l = 0;
+  oop o = nullptr;
+
+  bool set_int(jint v) { type = T_INT; i = v; return true; }
+  bool set_long(jlong v) { type = T_LONG; l = v; return true; }
+  bool set_object(oop v) { type = T_OBJECT; o = v; return true; }
+};
+
+inline juint load_be32(const jbyte* p) {
+  const uint8_t* b = (const uint8_t*) p;
+  return (juint) b[0] << 24 | (juint) b[1] << 16 | (juint) b[2] << 8 | b[3];
+}
+
+inline julong load_be64(const jbyte* p) {
+  return (julong) load_be32(p) << 32 | load_be32(p + 4);
+}
+
+inline juint load_le32(const jbyte* p) {
+  const uint8_t* b = (const uint8_t*) p;
+  return (juint) b[3] << 24 | (juint) b[2] << 16 | (juint) b[1] << 8 | b[0];
+}
+
+inline juint rotr32(juint x, int n) { return (x >> n) | (x << (32 - n)); }
+inline juint rotl32(juint x, int n) { return (x << n) | (x >> (32 - n)); }
+inline julong rotr64(julong x, int n) { return (x >> n) | (x << (64 - n)); }
+
+// The high 64 bits of the 128-bit product, as Math.unsignedMultiplyHigh and Math.multiplyHigh.
+inline julong umulh(julong a, julong b) {
+  julong a_lo = (juint) a, a_hi = a >> 32, b_lo = (juint) b, b_hi = b >> 32;
+  julong lo_lo = a_lo * b_lo, hi_lo = a_hi * b_lo, lo_hi = a_lo * b_hi, hi_hi = a_hi * b_hi;
+  julong cross = (lo_lo >> 32) + (juint) hi_lo + lo_hi;
+  return (hi_lo >> 32) + (cross >> 32) + hi_hi;
+}
+
+inline jlong smulh(jlong a, jlong b) {
+  return (jlong) (umulh((julong) a, (julong) b) - ((julong) (a >> 63) & (julong) b) -
+                  ((julong) (b >> 63) & (julong) a));
+}
+
+// ── AES (com.sun.crypto.provider.AESCrypt) ───────────────────────────────────────────────────
+// AESCrypt.java's rounds over the same tables: T1-T4 and S to encrypt, T5-T8 and Si to decrypt.
+// K is the session key the Java code made (K[0..3], K[4..limit-1] in rounds, K[limit..limit+3]
+// last to encrypt; K[4..7], K[8..limit+3], K[0..3] to decrypt).
+
+struct AesTables {
+  juint T1[256], T2[256], T3[256], T4[256], T5[256], T6[256], T7[256], T8[256];
+  uint8_t S[256], Si[256];
+};
+
+AesTables aes;
+volatile int aes_ready = 0;
+
+inline uint8_t gf_mul(uint8_t a, uint8_t b) {
+  uint8_t r = 0;
+  while (b != 0) {
+    if (b & 1) {
+      r ^= a;
+    }
+    a = (uint8_t) ((a << 1) ^ ((a & 0x80) ? 0x1b : 0));
+    b >>= 1;
+  }
+  return r;
+}
+
+void aes_init() {
+  if (Atomic::load_acquire(&aes_ready)) {
+    return;
+  }
+  // The S-box: the multiplicative inverse in GF(2^8), then the affine map.
+  for (int x = 0; x < 256; x++) {
+    uint8_t inv = 0;
+    for (int y = 1; y < 256 && x != 0; y++) {
+      if (gf_mul((uint8_t) x, (uint8_t) y) == 1) {
+        inv = (uint8_t) y;
+        break;
+      }
+    }
+    uint8_t s = inv ^ (uint8_t) (inv << 1 | inv >> 7) ^ (uint8_t) (inv << 2 | inv >> 6) ^
+                 (uint8_t) (inv << 3 | inv >> 5) ^ (uint8_t) (inv << 4 | inv >> 4) ^ 0x63;
+    aes.S[x] = s;
+    aes.Si[s] = (uint8_t) x;
+  }
+  for (int x = 0; x < 256; x++) {
+    uint8_t s = aes.S[x], si = aes.Si[x];
+    juint e = (juint) gf_mul(s, 2) << 24 | (juint) s << 16 | (juint) s << 8 | gf_mul(s, 3);
+    juint d = (juint) gf_mul(si, 14) << 24 | (juint) gf_mul(si, 9) << 16 |
+              (juint) gf_mul(si, 13) << 8 | gf_mul(si, 11);
+    aes.T1[x] = e; aes.T2[x] = rotr32(e, 8); aes.T3[x] = rotr32(e, 16); aes.T4[x] = rotr32(e, 24);
+    aes.T5[x] = d; aes.T6[x] = rotr32(d, 8); aes.T7[x] = rotr32(d, 16); aes.T8[x] = rotr32(d, 24);
+  }
+  Atomic::release_store(&aes_ready, 1);
+}
+
+inline void store_last(jbyte* out, uint8_t b0, uint8_t b1, uint8_t b2, uint8_t b3, juint k) {
+  out[0] = (jbyte) (b0 ^ (k >> 24));
+  out[1] = (jbyte) (b1 ^ (k >> 16));
+  out[2] = (jbyte) (b2 ^ (k >> 8));
+  out[3] = (jbyte) (b3 ^ k);
+}
+
+void aes_encrypt(const jint* K, int limit, const jbyte* in, jbyte* out) {
+  const juint *T1 = aes.T1, *T2 = aes.T2, *T3 = aes.T3, *T4 = aes.T4;
+  const uint8_t* S = aes.S;
+  juint t0 = load_be32(in) ^ K[0], t1 = load_be32(in + 4) ^ K[1];
+  juint t2 = load_be32(in + 8) ^ K[2], t3 = load_be32(in + 12) ^ K[3];
+  for (int k = 4; k < limit; k += 4) {
+    juint a0 = T1[t0 >> 24] ^ T2[(t1 >> 16) & 0xff] ^ T3[(t2 >> 8) & 0xff] ^ T4[t3 & 0xff] ^ K[k];
+    juint a1 = T1[t1 >> 24] ^ T2[(t2 >> 16) & 0xff] ^ T3[(t3 >> 8) & 0xff] ^ T4[t0 & 0xff] ^ K[k + 1];
+    juint a2 = T1[t2 >> 24] ^ T2[(t3 >> 16) & 0xff] ^ T3[(t0 >> 8) & 0xff] ^ T4[t1 & 0xff] ^ K[k + 2];
+    juint a3 = T1[t3 >> 24] ^ T2[(t0 >> 16) & 0xff] ^ T3[(t1 >> 8) & 0xff] ^ T4[t2 & 0xff] ^ K[k + 3];
+    t0 = a0; t1 = a1; t2 = a2; t3 = a3;
+  }
+  store_last(out,      S[t0 >> 24], S[(t1 >> 16) & 0xff], S[(t2 >> 8) & 0xff], S[t3 & 0xff], K[limit]);
+  store_last(out + 4,  S[t1 >> 24], S[(t2 >> 16) & 0xff], S[(t3 >> 8) & 0xff], S[t0 & 0xff], K[limit + 1]);
+  store_last(out + 8,  S[t2 >> 24], S[(t3 >> 16) & 0xff], S[(t0 >> 8) & 0xff], S[t1 & 0xff], K[limit + 2]);
+  store_last(out + 12, S[t3 >> 24], S[(t0 >> 16) & 0xff], S[(t1 >> 8) & 0xff], S[t2 & 0xff], K[limit + 3]);
+}
+
+void aes_decrypt(const jint* K, int limit, const jbyte* in, jbyte* out) {
+  const juint *T5 = aes.T5, *T6 = aes.T6, *T7 = aes.T7, *T8 = aes.T8;
+  const uint8_t* Si = aes.Si;
+  juint t0 = load_be32(in) ^ K[4], t1 = load_be32(in + 4) ^ K[5];
+  juint t2 = load_be32(in + 8) ^ K[6], t3 = load_be32(in + 12) ^ K[7];
+  for (int k = 8; k < limit + 4; k += 4) {
+    juint a0 = T5[t0 >> 24] ^ T6[(t3 >> 16) & 0xff] ^ T7[(t2 >> 8) & 0xff] ^ T8[t1 & 0xff] ^ K[k];
+    juint a1 = T5[t1 >> 24] ^ T6[(t0 >> 16) & 0xff] ^ T7[(t3 >> 8) & 0xff] ^ T8[t2 & 0xff] ^ K[k + 1];
+    juint a2 = T5[t2 >> 24] ^ T6[(t1 >> 16) & 0xff] ^ T7[(t0 >> 8) & 0xff] ^ T8[t3 & 0xff] ^ K[k + 2];
+    juint a3 = T5[t3 >> 24] ^ T6[(t2 >> 16) & 0xff] ^ T7[(t1 >> 8) & 0xff] ^ T8[t0 & 0xff] ^ K[k + 3];
+    t0 = a0; t1 = a1; t2 = a2; t3 = a3;
+  }
+  store_last(out,      Si[t0 >> 24], Si[(t3 >> 16) & 0xff], Si[(t2 >> 8) & 0xff], Si[t1 & 0xff], K[0]);
+  store_last(out + 4,  Si[t1 >> 24], Si[(t0 >> 16) & 0xff], Si[(t3 >> 8) & 0xff], Si[t2 & 0xff], K[1]);
+  store_last(out + 8,  Si[t2 >> 24], Si[(t1 >> 16) & 0xff], Si[(t0 >> 8) & 0xff], Si[t3 & 0xff], K[2]);
+  store_last(out + 12, Si[t3 >> 24], Si[(t2 >> 16) & 0xff], Si[(t1 >> 8) & 0xff], Si[t0 & 0xff], K[3]);
+}
+
+Fields<2> aes_fields;
+const char* const aes_field_names[2][2] = { { "K", "[I" }, { "limit", "I" } };
+
+// An AESCrypt's session key and limit, or null if cipher is not one with a key.
+const jint* aes_key(oop cipher, int* limit) {
+  Klass* k = cipher->klass();
+  if (boot_class(k, "com/sun/crypto/provider/AESCrypt") != k || !aes_fields.lookup(k, aes_field_names)) {
+    return nullptr;
+  }
+  *limit = cipher->int_field(aes_fields.off[1]);
+  if (*limit != 40 && *limit != 48 && *limit != 56) {
+    return nullptr;
+  }
+  aes_init();
+  return array_field<jint>(cipher, aes_fields.off[0], T_INT, *limit + 4);
+}
+
+// AESCrypt.implEncryptBlock / implDecryptBlock(byte[] in, int inOffset, byte[] out, int outOffset)
+bool aes_block(const Args& args, bool decrypt) {
+  typeArrayOop in = args.a(1), out = args.a(3);
+  jint in_ofs = args.i(2), out_ofs = args.i(4);
+  int limit;
+  const jint* K = aes_key(args.o(0), &limit);
+  if (K == nullptr || !in_bounds(in, in_ofs, 16) || !in_bounds(out, out_ofs, 16)) {
+    return false;
+  }
+  const jbyte* src = (const jbyte*) in->base(T_BYTE) + in_ofs;
+  jbyte* dst = (jbyte*) out->base(T_BYTE) + out_ofs;
+  if (decrypt) {
+    aes_decrypt(K, limit, src, dst);
+  } else {
+    aes_encrypt(K, limit, src, dst);
+  }
+  return true;
+}
+
+Fields<5> ctr_fields;
+const char* const ctr_field_names[5][2] = {
+  { "embeddedCipher", "Lcom/sun/crypto/provider/SymmetricCipher;" }, { "blockSize", "I" },
+  { "counter", "[B" }, { "encryptedCounter", "[B" }, { "used", "I" }
+};
+
+// CounterMode.implCrypt(byte[] in, int inOff, int len, byte[] out, int outOff): XORs len bytes with
+// the key stream, encrypting the counter (and incrementing it) when a block of it is used up.
+bool ctr_crypt(Klass* holder, const Args& args, Result* result) {
+  oop mode = args.o(0);
+  typeArrayOop in = args.a(1), out = args.a(4);
+  jint in_ofs = args.i(2), len = args.i(3), out_ofs = args.i(5);
+  if (!ctr_fields.lookup(holder, ctr_field_names) || !in_bounds(in, in_ofs, len) ||
+      !in_bounds(out, out_ofs, len)) {
+    return false;
+  }
+  oop cipher = mode->obj_field(ctr_fields.off[0]);
+  typeArrayOop counter = (typeArrayOop) mode->obj_field(ctr_fields.off[2]);
+  jint used = mode->int_field(ctr_fields.off[4]);
+  int limit;
+  const jint* K = cipher != nullptr ? aes_key(cipher, &limit) : nullptr;
+  jbyte* stream = array_field<jbyte>(mode, ctr_fields.off[3], T_BYTE, 16);
+  if (K == nullptr || stream == nullptr || mode->int_field(ctr_fields.off[1]) != 16 ||
+      counter == nullptr || counter->length() < 16 || used < 0) {
+    return false;
+  }
+  jbyte* ctr = (jbyte*) counter->base(T_BYTE);
+  int ctr_len = counter->length();
+  const jbyte* src = (const jbyte*) in->base(T_BYTE) + in_ofs;
+  jbyte* dst = (jbyte*) out->base(T_BYTE) + out_ofs;
+  for (jint i = 0; i < len; i++) {
+    if (used >= 16) {
+      aes_encrypt(K, limit, ctr, stream);
+      for (int n = ctr_len - 1; n >= 0 && ++ctr[n] == 0; n--) {
+      }
+      used = 0;
+    }
+    dst[i] = (jbyte) (src[i] ^ stream[used++]);
+  }
+  mode->int_field_put(ctr_fields.off[4], used);
+  return result->set_int(len);
+}
+
+// ── GHASH (com.sun.crypto.provider.GHASH) ────────────────────────────────────────────────────
+
+// GHASH.processBlocks(byte[] data, int inOfs, int blocks, long[] st, long[] subH): GHASH.java's
+// blockMult, a bit at a time, for each block.
+bool ghash_blocks(const Args& args) {
+  typeArrayOop data = args.a(0), st = args.a(3), subH = args.a(4);
+  jint ofs = args.i(1), blocks = args.i(2);
+  if (!in_bounds(data, ofs, (jlong) blocks * 16) || st == nullptr || st->length() < 2 ||
+      subH == nullptr || subH->length() < 2) {
+    return false;
+  }
+  julong* s = (julong*) st->base(T_LONG);
+  const julong* h = (const julong*) subH->base(T_LONG);
+  const jbyte* p = (const jbyte*) data->base(T_BYTE) + ofs;
+  julong z0 = s[0], z1 = s[1];
+  for (jint b = 0; b < blocks; b++, p += 16) {
+    julong x0 = z0 ^ load_be64(p), x1 = z1 ^ load_be64(p + 8);
+    julong v0 = h[0], v1 = h[1];
+    z0 = z1 = 0;
+    for (int i = 0; i < 128; i++) {
+      julong x = i < 64 ? x0 << i : x1 << (i - 64);
+      julong mask = 0 - (x >> 63);
+      z0 ^= v0 & mask;
+      z1 ^= v1 & mask;
+      julong reduce = 0 - (v1 & 1);
+      v1 = (v1 >> 1) | (v0 << 63);
+      v0 = (v0 >> 1) ^ (0xe100000000000000ULL & reduce);
+    }
+  }
+  s[0] = z0;
+  s[1] = z1;
+  return true;
+}
