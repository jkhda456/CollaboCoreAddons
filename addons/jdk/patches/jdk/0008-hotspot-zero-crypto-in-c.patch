+// A digest class the C here does: the class whose int[] or long[] state it compresses into.
+struct Digest {
+  const char* klass;
+  const char* state_sig;
+  int state_len;
+  int block_size;
+  Fields<1>* fields;
+  void (*compress)(void* state, const jbyte* block);
+};
+
+Fields<1> md5_fields, sha1_fields, sha2_fields, sha5_fields;
+
+const Digest digests[] = {
+  { "sun/security/provider/MD5",  "[I", 4, 64,  &md5_fields,  (void (*)(void*, const jbyte*)) md5_compress },
+  { "sun/security/provider/SHA",  "[I", 5, 64,  &sha1_fields, (void (*)(void*, const jbyte*)) sha1_compress },
+  { "sun/security/provider/SHA2", "[I", 8, 64,  &sha2_fields, (void (*)(void*, const jbyte*)) sha256_compress },
+  { "sun/security/provider/SHA5", "[J", 8, 128, &sha5_fields, (void (*)(void*, const jbyte*)) sha512_compress },
+};
+
+// The digest's state array if o is one of the digests, null if not.
+void* digest_state(oop o, const Digest** which) {
+  for (const Digest& d : digests) {
+    Klass* k = boot_class(o->klass(), d.klass);
+    if (k == nullptr) {
+      continue;
+    }
+    const char* const names[1][2] = { { "state", d.state_sig } };
+    if (!d.fields->lookup(k, names)) {
+      return nullptr;
+    }
+    *which = &d;
+    return d.state_sig[1] == 'I'
+        ? (void*) array_field<jint>(o, d.fields->off[0], T_INT, d.state_len)
+        : (void*) array_field<jlong>(o, d.fields->off[0], T_LONG, d.state_len);
+  }
+  return nullptr;
+}
+
+// MD5/SHA/SHA2/SHA5.implCompress0(byte[] buf, int ofs)
+bool digest_block(const Args& args) {
+  typeArrayOop buf = args.a(1);
+  jint ofs = args.i(2);
+  const Digest* d;
+  void* state = digest_state(args.o(0), &d);
+  if (state == nullptr || !in_bounds(buf, ofs, d->block_size)) {
+    return false;
+  }
+  d->compress(state, (const jbyte*) buf->base(T_BYTE) + ofs);
+  return true;
+}
+
+// DigestBase.implCompressMultiBlock0(byte[] b, int ofs, int limit): every block from ofs that
+// starts at or before limit, returning the offset after the last.
+bool digest_blocks(const Args& args, Result* result) {
+  typeArrayOop buf = args.a(1);
+  jint ofs = args.i(2), limit = args.i(3);
+  const Digest* d;
+  void* state = digest_state(args.o(0), &d);
+  if (state == nullptr) {
+    return false;
+  }
+  if (ofs > limit) {
+    return result->set_int(ofs);
+  }
+  if (!in_bounds(buf, ofs, (jlong) limit - ofs + d->block_size)) {
+    return false;
+  }
+  const jbyte* p = (const jbyte*) buf->base(T_BYTE);
+  for (; ofs <= limit; ofs += d->block_size) {
+    d->compress(state, p + ofs);
+  }
+  return result->set_int(ofs);
+}
