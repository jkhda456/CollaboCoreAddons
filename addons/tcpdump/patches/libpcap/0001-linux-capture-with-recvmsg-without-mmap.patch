+#ifdef PCAP_LINUX_NO_MMAP
+/*
+ * Capture with recvmsg(), one packet at a time, for systems without mmap().
+ *
+ * Each packet is received into handle->buffer laid out as a ring frame would
+ * be - a tpacket2_hdr's room, the sockaddr_ll after it, then room for the
+ * headers pcap_handle_packet_mmap() puts in front of the packet (a cooked
+ * header, a VLAN tag), then the packet - so that function handles it as it
+ * handles the ring's.
+ */
+#define RECV_SLL_OFFSET	TPACKET_ALIGN(sizeof(struct tpacket2_hdr))
+#define RECV_MAC_OFFSET	TPACKET_ALIGN(RECV_SLL_OFFSET + sizeof(struct sockaddr_ll) + \
+			    SLL2_HDR_LEN + VLAN_TAG_LEN)
+#define RECV_EMPTY	(-100)	/* nothing to read now (not a PCAP_ERROR_ value) */
+
+static int
+setup_recv(pcap_t *handle)
+{
+	struct pcap_linux *handlep = handle->priv;
+	int one = 1;
+
+	handlep->tp_version = 0;	/* no ring */
+	handlep->tp_hdrlen = sizeof(struct tpacket2_hdr);
+	handle->bufsize = RECV_MAC_OFFSET + handle->snapshot;
+	handle->buffer = malloc(handle->bufsize);
+	if (handle->buffer == NULL) {
+		pcapint_fmt_errmsg_for_errno(handle->errbuf, PCAP_ERRBUF_SIZE,
+		    errno, "can't allocate packet buffer");
+		return PCAP_ERROR;
+	}
+
+	/*
+	 * The VLAN tag the kernel took off, and the packet's length before
+	 * the filter cut it, come in PACKET_AUXDATA; the time it arrived in
+	 * SO_TIMESTAMPNS.  Without them, there is no tag and the time is
+	 * when we read it.
+	 */
+	(void)setsockopt(handle->fd, SOL_PACKET, PACKET_AUXDATA, &one,
+	    sizeof(one));
+	(void)setsockopt(handle->fd, SOL_SOCKET, SO_TIMESTAMPNS, &one,
+	    sizeof(one));
+	/*
+	 * The socket's receive buffer stands in for the ring, and gets its
+	 * size: by default 2M, as the ring does.  Past net.core.rmem_max
+	 * only root may go.
+	 */
+	if (handle->opt.buffer_size == 0)
+		handle->opt.buffer_size = 2*1024*1024;
+	if (setsockopt(handle->fd, SOL_SOCKET, SO_RCVBUFFORCE,
+	    &handle->opt.buffer_size, sizeof(handle->opt.buffer_size)) == -1)
+		(void)setsockopt(handle->fd, SOL_SOCKET, SO_RCVBUF,
+		    &handle->opt.buffer_size, sizeof(handle->opt.buffer_size));
+	set_poll_timeout(handlep);
+	return 0;
+}
+
+/*
+ * Read one packet and hand it to the callback.  Returns 1 if the callback got
+ * it, 0 if it was filtered out, RECV_EMPTY if there was none to read, or a
+ * PCAP_ERROR_ value.
+ */
+static int
+pcap_recv_one_linux(pcap_t *handle, pcap_handler callback, u_char *user)
+{
+	struct pcap_linux *handlep = handle->priv;
+	u_char *frame = handle->buffer;
+	struct sockaddr_ll *sll = (struct sockaddr_ll *)(frame + RECV_SLL_OFFSET);
+	union {
+		struct cmsghdr cmsg;
+		char buf[CMSG_SPACE(sizeof(struct tpacket_auxdata)) +
+		    CMSG_SPACE(2 * sizeof(int64_t))];
+	} control;
+	struct tpacket_auxdata aux;
+	struct msghdr msg;
+	struct iovec iov;
+	struct cmsghdr *cmsg;
+	struct timespec ts = { 0, 0 };
+	int have_aux = 0, have_ts = 0;
+	ssize_t got;
+	unsigned int caplen, len;
+
+	memset(sll, 0, sizeof(*sll));
+	iov.iov_base = frame + RECV_MAC_OFFSET;
+	iov.iov_len = handle->bufsize - RECV_MAC_OFFSET;
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_name = sll;
+	msg.msg_namelen = sizeof(*sll);
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	msg.msg_control = &control;
+	msg.msg_controllen = sizeof(control);
+
+	got = recvmsg(handle->fd, &msg, MSG_TRUNC | MSG_DONTWAIT);
+	if (got < 0) {
+		switch (errno) {
+
+		case EAGAIN:
+#if EWOULDBLOCK != EAGAIN
+		case EWOULDBLOCK:
+#endif
+		case EINTR:
+			return RECV_EMPTY;
+
+		case ENETDOWN:
+			/*
+			 * The device went down or away; as for the ring,
+			 * the wait finds out which.
+			 */
+			handlep->netdown = 1;
+			handle->required_select_timeout = &netdown_timeout;
+			return RECV_EMPTY;
+
+		default:
+			pcapint_fmt_errmsg_for_errno(handle->errbuf,
+			    PCAP_ERRBUF_SIZE, errno, "recvmsg");
+			return PCAP_ERROR;
+		}
+	}
+	if (handlep->netdown) {
+		/* a packet: the device is there and up */
+		handlep->netdown = 0;
+		handle->required_select_timeout = NULL;
+	}
+
+	/* with MSG_TRUNC, got is the packet's length, not what fit */
+	caplen = (size_t)got < iov.iov_len ? (unsigned int)got : (unsigned int)iov.iov_len;
+	len = (unsigned int)got;
+	for (cmsg = CMSG_FIRSTHDR(&msg); cmsg != NULL; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+		size_t size = cmsg->cmsg_len - CMSG_LEN(0);
+
+		if (cmsg->cmsg_level == SOL_PACKET &&
+		    cmsg->cmsg_type == PACKET_AUXDATA &&
+		    size >= sizeof(aux)) {
+			memcpy(&aux, CMSG_DATA(cmsg), sizeof(aux));
+			have_aux = 1;
+		} else if (cmsg->cmsg_level == SOL_SOCKET &&
+		    cmsg->cmsg_type == SO_TIMESTAMPNS) {
+			/* 64-bit seconds and nanoseconds, or two longs */
+			if (size >= 2 * sizeof(int64_t)) {
+				int64_t v[2];
+
+				memcpy(v, CMSG_DATA(cmsg), sizeof(v));
+				ts.tv_sec = (time_t)v[0];
+				ts.tv_nsec = (long)v[1];
+				have_ts = 1;
+			} else if (size >= 2 * sizeof(long)) {
+				long v[2];
+
+				memcpy(v, CMSG_DATA(cmsg), sizeof(v));
+				ts.tv_sec = v[0];
+				ts.tv_nsec = v[1];
+				have_ts = 1;
+			}
+		}
+	}
+	if (have_aux && aux.tp_len > len)
+		len = aux.tp_len;	/* the length on the wire, before the filter cut it */
+	if (!have_ts)
+		(void)clock_gettime(CLOCK_REALTIME, &ts);
+
+	return pcap_handle_packet_mmap(handle, callback, user, frame, len,
+	    RECV_MAC_OFFSET, caplen, (unsigned int)ts.tv_sec,
+	    handle->opt.tstamp_precision == PCAP_TSTAMP_PRECISION_NANO ?
+	    (unsigned int)ts.tv_nsec : (unsigned int)(ts.tv_nsec / 1000),
+	    have_aux && VLAN_VALID(&aux, &aux),
+	    have_aux ? aux.tp_vlan_tci : 0,
+	    have_aux ? VLAN_TPID(&aux, &aux) : ETH_P_8021Q);
+}
+
+static int
+pcap_read_linux_recv(pcap_t *handle, int max_packets, pcap_handler callback,
+		u_char *user)
+{
+	int pkts = 0;
+	int waited = 0;
+	int ret;
+
+	if (PACKET_COUNT_IS_UNLIMITED(max_packets))
+		max_packets = INT_MAX;
+
+	while (pkts < max_packets) {
+		if (handle->break_loop) {
+			handle->break_loop = 0;
+			return PCAP_ERROR_BREAK;
+		}
+		ret = pcap_recv_one_linux(handle, callback, user);
+		if (ret == 1) {
+			pkts++;
+			continue;
+		}
+		if (ret == 0)
+			continue;	/* filtered out */
+		if (ret != RECV_EMPTY)
+			return ret;
+		/*
+		 * Nothing to read: return what we have, or wait (once) for
+		 * more - until the timeout, a pcap_breakloop() or an error.
+		 */
+		if (pkts > 0 || waited)
+			break;
+		ret = pcap_wait_for_frames_mmap(handle);
+		if (ret)
+			return ret;
+		waited = 1;
+	}
+	return pkts;
+}
+#endif /* PCAP_LINUX_NO_MMAP */
+
 #ifdef HAVE_TPACKET3
