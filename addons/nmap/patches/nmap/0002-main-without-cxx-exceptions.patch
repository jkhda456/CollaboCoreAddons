nmap: main() without C++ exceptions

The guest's libc++ is built without exceptions (as the other add-ons' is), and
nmap with -fno-exceptions: main()'s try and its catch blocks for bad_alloc and
other exceptions are left out then (__cpp_exceptions), and a failed
allocation aborts.

diff --git a/main.cc b/main.cc
index bdfd3d9..1ca49b7 100644
--- a/main.cc
+++ b/main.cc
@@ -140,7 +140,10 @@ int main(int argc, char *argv[]) {
   mtrace();
 #endif
 
+  /* Built without C++ exceptions (WebAssembly), a failed allocation aborts. */
+#ifdef __cpp_exceptions
  try {
+#endif
   if ((cptr = getenv("NMAP_ARGS"))) {
     char *tail = command;
     int rem = sizeof(command);
@@ -179,6 +182,7 @@ int main(int argc, char *argv[]) {
   }
 
   return nmap_main(argc, argv);
+#ifdef __cpp_exceptions
  }
  catch (const std::bad_alloc &) {
    fprintf(stderr, "FATAL: Out of memory.\n");
@@ -193,4 +197,5 @@ int main(int argc, char *argv[]) {
    fprintf(stderr, "FATAL: Unhandled unknown C++ exception.\n");
    return 1;
  }
+#endif
 }
